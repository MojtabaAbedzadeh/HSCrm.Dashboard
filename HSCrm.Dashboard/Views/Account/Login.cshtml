@using HSCrm.Models.ModelDto
@{
    ViewData["Title"] = "فرم ورود";
}

<div style="width:700px" class="row justify-content-center">
    <div class="col-lg-6 col-md-10">
        <div class="card">
            <div class="card-header bg-primary">
                <div class="ec-brand">
                    <a href="index.html" title="Ekka">
                        <img class="ec-brand-icon" src="~/assets/img/logo/logo-login.png" alt="">
                    </a>
                </div>
            </div>
            <div class="card-body p-5">
                <h4 class="text-dark mb-5">ورود به سیستم</h4>

                <form id="loginForm" method="post" action="/Account/Login">
                    <div class="row">
                        <!-- بخش اول: اعتبار سنجی -->
                        <div id="step1">
                            <div class="form-group mb-4">
                                <input type="text" class="form-control" id="UserName" name="UserName" placeholder="نام کاربری">
                            </div>
                            <div class="form-group mb-4">
                                <input type="password" class="form-control" id="Password" name="Password" placeholder="رمز عبور">
                            </div>
                            <button type="button" onclick="checkUser()" class="btn btn-primary btn-block">مرحله بعد</button>
                        </div>

                        <!-- بخش دوم: انتخاب سال مالی (در ابتدا مخفی) -->
                        <div id="step2" style="display:none;">
                            <div class="alert alert-info">کاربر تایید شد. لطفا سال مالی را انتخاب کنید.</div>
                            <div class="form-group mb-4">
                                <label>انتخاب سال مالی</label>
                                <select id="FiscalYearId" name="FiscalYearId" class="form-control"></select>
                            </div>
                            <button type="submit" class="btn btn-success btn-block">ورود به داشبورد</button>
                            <button type="button" onclick="location.reload()" class="btn btn-link btn-block">تغییر کاربر</button>
                        </div>

                        <div id="errorMsg" class="alert mt-3" style="display:none; color:red; text-align:center;"></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function checkUser() {
        const user = (document.getElementById("UserName").value || "").trim();
        const pass = (document.getElementById("Password").value || "").trim();
        if (!user || !pass) {
            showError("لطفاً نام کاربری و رمز عبور را وارد کنید.");
            if (window.SwalHelper) {
                SwalHelper.warning("لطفاً نام کاربری و رمز عبور را وارد نمایید.", "اطلاعات ناقص");
            }
            return;
        }
        fetch(`/Account/CheckUserAndGetFiscals?userName=${encodeURIComponent(user)}&password=${encodeURIComponent(pass)}`, { method: 'POST' })
            .then(res => {
                if (!res.ok) throw new Error("خطای ارتباط با سرور");
                return res.json();
            })
            .then(data => {
                if (data && data.success) {
                    const select = document.getElementById("FiscalYearId");
                    select.innerHTML = "";
                    (data.fiscalYears || []).forEach(item => {
                        let opt = document.createElement('option');
                        opt.value = item.drId;
                        opt.innerHTML = item.drName;
                        select.appendChild(opt);
                    });
                    document.getElementById("step1").style.display = "none";
                    document.getElementById("step2").style.display = "block";
                    document.getElementById("errorMsg").style.display = "none";
                    if (window.SwalHelper) {
                        SwalHelper.toast("کاربر تأیید شد. لطفاً سال مالی را انتخاب نمایید.", "success");
                    }
                } else {
                    const msg = (data && data.message) || "نام کاربری یا رمز عبور اشتباه است.";
                    showError(msg);
                    if (window.SwalHelper) {
                        SwalHelper.error(msg, "عدم ورود");
                    }
                }
            })
            .catch(err => {
                const msg = err.message || "خطا در برقراری ارتباط با سرور.";
                showError(msg);
                if (window.SwalHelper) {
                    SwalHelper.error(msg, "خطای ارتباط");
                }
            });
    }
    function showError(msg) {
        const err = document.getElementById("errorMsg");
        if (err) {
            err.innerHTML = msg;
            err.style.display = "block";
        }
    }
</script>
