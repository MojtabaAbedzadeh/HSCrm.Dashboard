@using HSCrm.BussinessLagic.Tools
@using HSCrm.Dashboard.Costants
@model IEnumerable<SalesInvoiceModel>

@{
    ViewData["Title"] = "فاکتورهای فروش";
    ViewData["selected"] = "invoice_salles_list";

    string ApiAddress = ViewBag.ApiAddress;
}

@section styles {
    <link href="~/assets/plugins/data-tables/datatables.bootstrap5.min.css" rel="stylesheet">
    <link href="~/assets/plugins/data-tables/responsive.datatables.min.css" rel="stylesheet">
    <link href="~/assets/css/ekka.css" id="ekka-css" rel="stylesheet">
    <link href="~/lib/persiandate/persian-datepicker.css" rel="stylesheet" />
}
<div class="breadcrumb-wrapper breadcrumb-contacts">
    <div>
        <h1>لیست فاکتورهای فروش</h1>
        <p class="breadcrumbs"><span><a href="/AdminArea/Home/Index">خانه</a></span> <span><i class="mdi mdi-chevron-left"></i></span>فاکتور فروش</p>
    </div>
    @if (ViewBag.FiscalYearStatus == "0")
    {
        <div>
            @if (User.HasPermission(Permissions.SalesInvoices.Create))
            {
                <a type="button" class="btn btn-primary" href="/adminarea/invoice/AddSaleInvoice">افزودن فاکتور فروش</a>
            }
            @if (User.HasPermission(Permissions.Tenants.View) && User.HasPermission(Permissions.Tenants.Edit))
            {
                <button type="button" class="btn btn-outline-secondary ms-2" data-bs-toggle="modal" data-bs-target="#invoicePatternModal" onclick="loadInvoicePatterns()"><i class="mdi mdi-cog-outline me-1"></i> تنظیم الگوی فاکتور</button>
            }
        </div>
    }
</div>
@if (ViewBag.FiscalYearStatus != "0")
{
    <div class="alert alert-primary col-lg-8" role="alert" style="margin-top:40px; color:#084298;">
        توجه!
        <br>
        سال مالی انتخاب شده بسته می باشد! شما فقط قادر به مشاهده گزارشات سیستم هستید.
    </div>
}
<div class="row">
    <div class="col-12">
        <div class="ec-vendor-list card card-default">
            <div class="card-body">
                <div class="table-responsive-md">
                    <div id="responsive-data-table_wrapper" class="dataTables_wrapper dt-bootstrap5 no-footer">
                        <table id="responsive-data-table" class="table dataTable no-footer" aria-describedby="responsive-data-table_info">
                            <thead>
                                <tr>
                                    <th>شماره فاکتور</th>
                                    <th>تاریخ فاکتور</th>
                                    <th>عنوان پروژه</th>
                                    <th>مشتری</th>
                                    <th>نوع فاکتور</th>
                                    <th>جمع فاکتور</th>
                                    <th>دریافت‌شده / چک</th>
                                    <th>مانده و وضعیت</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Number</td>
                                        <td class="font-monospace">@ConvertDate.ConvertMiladiToShamsi(item.IssueDate, "yyyy/MM/dd")</td>
                                        <td>@(item.Project?.ProjectTitle ?? "-")</td>
                                        <td>@(item.Project?.Customer?.Name ?? "-")</td>
                                        <td>
                                            <span class="badge @(item.Status == 1 ? "bg-success" : "bg-info")">
                                                @(item.Status == 1 ? "فاکتور نهایی" : "پیش فاکتور")
                                            </span>
                                        </td>
                                        <td class="font-monospace fw-bold" dir="ltr">@item.Total.ToString("N0")</td>
                                        <td class="si-paid-cell font-monospace small" data-inv-id="@item.Id" data-status="@item.Status"><span class="text-muted">...</span></td>
                                        <td class="si-rem-cell font-monospace small" data-inv-id="@item.Id" data-status="@item.Status"><span class="text-muted">...</span></td>
                                        <td>
                                            <div class="btn-group mb-1">
                                                <button type="button" class="btn btn-outline-success" onclick="showInvoiceDetail('@item.Id')">جزئیات</button>
                                                <button type="button" class="btn btn-outline-success dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-display="static">
                                                    <span class="sr-only">اطلاعات</span>
                                                </button>
                                                @if (ViewBag.FiscalYearStatus == "0")
                                                {
                                                    <div class="dropdown-menu">
                                                        @if (User.HasPermission(Permissions.SalesInvoices.Edit))
                                                        {
                                                            <a class="dropdown-item" href="#"><i class="mdi mdi-email-edit"></i> ویرایش</a>
                                                        }
                                                        @if (User.HasPermission(Permissions.SalesInvoices.Delete))
                                                        {
                                                            <a class="dropdown-item" href="#"><i class="mdi mdi-trash-can"></i> حذف</a>
                                                        }
                                                        @if (item.Status == 0)
                                                        {
                                                            <div class="dropdown-divider"></div>
                                                            <a class="dropdown-item text-primary" href="javascript:void(0)" onclick="confirmInvoice('@item.Id')">
                                                                <i class="mdi mdi-file"></i>
                                                                تبدیل به فاکتور نهایی
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <div class="dropdown-divider"></div>
                                                            <a class="dropdown-item text-success" href="/AdminArea/Receipt/Index?invoiceId=@item.Id">
                                                                <i class="mdi mdi-cash-plus me-1"></i>
                                                                ثبت دریافت وجه / چک
                                                            </a>
                                                            <a class="dropdown-item text-warning" href="/AdminArea/ReturnInvoice/SalesReturn?invoiceId=@item.Id">
                                                                <i class="mdi mdi-keyboard-return me-1"></i>
                                                                ثبت برگشت از فروش
                                                            </a>
                                                            <a class="dropdown-item text-info" href="/AdminArea/Accounting/Vouchers?refType=1&refId=@item.Id">
                                                                <i class="mdi mdi-book-open-page-variant me-1"></i>
                                                                مشاهده سند حسابداری
                                                            </a>
                                                            <a class="dropdown-item text-dark" href="javascript:void(0)" onclick="openSalesInvoicePrintModal('@item.Id', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Number ?? ""))', '@ConvertDate.ConvertMiladiToShamsi(item.IssueDate, "yyyy/MM/dd")', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Project?.Customer?.Name ?? "-"))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Project?.ProjectTitle ?? "-"))', '@item.Total')">
                                                                <i class="mdi mdi-printer me-1"></i>
                                                                نمایش ریز اقلام و چاپ رسمی (A4)
                                                            </a>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="dropdown-menu"></div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- مودال مشاهده ریز اقلام و چاپ رسمی فاکتور فروش (A4) -->
<div class="modal fade" id="printOfficialSalesInvoiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="modal-title"><i class="mdi mdi-printer me-1"></i>نمایش جزئیات و چاپ رسمی فاکتور فروش</h5>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-warning fw-bold" onclick="window.print()">
                        <i class="mdi mdi-printer me-1"></i>چاپ فاکتور رسمی (A4)
                    </button>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
            </div>
            <div class="modal-body p-4" id="officialInvoicePrintArea">
                <div class="border border-2 border-dark p-4 rounded">
                    <div class="d-flex justify-content-between align-items-center border-bottom border-dark pb-3 mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <img id="prCompanyLogo" src="" alt="لوگو" style="max-height:56px; display:none;" />
                            <div>
                                <h4 class="fw-bold mb-1" id="prCompanyName">صورت‌حساب فروش کالا و خدمات</h4>
                                <div class="text-muted small" id="prCompanySubtitle">سامانه جامع مالی و حسابداری</div>
                            </div>
                        </div>
                        <div class="text-end font-monospace">
                            <div><strong>شماره فاکتور:</strong> <span id="prInvNumber">-</span></div>
                            <div><strong>تاریخ صدور:</strong> <span id="prInvDate">-</span></div>
                        </div>
                    </div>
                    <div class="row g-2 mb-3 p-2 bg-light border rounded small">
                        <div class="col-md-6"><strong>خریدار / طرف‌حساب:</strong> <span id="prInvCustomer">-</span></div>
                        <div class="col-md-6"><strong>پروژه مرتبط:</strong> <span id="prInvProject">-</span></div>
                    </div>
                    <table class="table table-bordered border-dark align-middle text-center small mb-3">
                        <thead class="table-secondary border-dark">
                            <tr>
                                <th>ردیف</th>
                                <th>شرح کالا / خدمات</th>
                                <th>تعداد</th>
                                <th>مبلغ واحد (ریال)</th>
                                <th>تخفیف</th>
                                <th>مالیات و عوارض</th>
                                <th>مبلغ کل پس از تخفیف و مالیات (ریال)</th>
                            </tr>
                        </thead>
                        <tbody id="prInvItemsBody"></tbody>
                        <tfoot>
                            <tr class="table-light fw-bold">
                                <td colspan="6" class="text-end">جمع کل قابل پرداخت (ریال):</td>
                                <td class="font-monospace fs-6 text-primary" id="prInvTotal">0</td>
                            </tr>
                        </tfoot>
                    </table>
                    <div id="prInvoiceFooter" class="alert alert-light border small text-muted mb-3" style="display:none;"></div>
                    <div class="row mt-5 pt-4 text-center small">
                        <div class="col-4"><div class="border-top border-dark pt-2">مهر و امضای فروشنده</div></div>
                        <div class="col-4"><div class="border-top border-dark pt-2">تایید واحد مالی و حسابداری</div></div>
                        <div class="col-4"><div class="border-top border-dark pt-2">مهر و امضای خریدار</div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function openSalesInvoicePrintModal(id, number, dateStr, customer, project, total) {
        document.getElementById('prInvNumber').textContent = number || id;
        document.getElementById('prInvDate').textContent = dateStr || '-';
        document.getElementById('prInvCustomer').textContent = customer || '-';
        document.getElementById('prInvProject').textContent = project || '-';
        document.getElementById('prInvTotal').textContent = Number(total || 0).toLocaleString('fa-IR');
        document.getElementById('prCompanyLogo').style.display = 'none';
        document.getElementById('prCompanyName').textContent = 'صورت‌حساب فروش کالا و خدمات';
        document.getElementById('prCompanySubtitle').textContent = 'سامانه جامع مالی و حسابداری';
        document.getElementById('prInvoiceFooter').style.display = 'none';

        const tbody = document.getElementById('prInvItemsBody');
        tbody.innerHTML = '<tr><td colspan="7" class="py-3 text-muted">در حال دریافت ریز اقلام فاکتور از سرور...</td></tr>';
        new bootstrap.Modal(document.getElementById('printOfficialSalesInvoiceModal')).show();

        const apiBase = '@ApiAddress'.endsWith('/') ? '@ApiAddress' : '@ApiAddress/';
        const authHeader = { 'Authorization': 'Bearer ' + '@User.FindFirstValue("Token")' };

        if (@(User.HasPermission(Permissions.Tenants.View).ToString().ToLower()))
        fetch(apiBase + 'Tenant/GetCompanySettings', { headers: authHeader, suppressGlobalAlert: true })
            .then(r => r.ok ? r.json() : null)
            .then(res => {
                const s = res ? (res.data || res) : null;
                if (!s) return;
                if (s.companyName || s.name) {
                    document.getElementById('prCompanyName').textContent = s.companyName || s.name;
                    document.getElementById('prCompanySubtitle').textContent = 'صورت‌حساب رسمی فروش کالا و خدمات' + (s.economicCode ? (' | کد اقتصادی: ' + s.economicCode) : '');
                }
                if (s.logoPath) {
                    const logoEl = document.getElementById('prCompanyLogo');
                    logoEl.src = s.logoPath.startsWith('http') ? s.logoPath : (apiBase.replace(/\/api\/?$/i, '/') + s.logoPath.replace(/^\/+/, ''));
                    logoEl.style.display = 'block';
                }
                if (s.invoiceFooterText) {
                    const footerEl = document.getElementById('prInvoiceFooter');
                    footerEl.textContent = s.invoiceFooterText;
                    footerEl.style.display = 'block';
                }
            }).catch(() => {});

        fetch(apiBase + 'SalesInvoice/GetById?invoiceId=' + id, {
            headers: authHeader
        })
        .then(r => r.json())
        .then(res => {
            const inv = res.data || res || {};
            const items = inv.items || inv.salesInvoiceItems || [];
            if (!Array.isArray(items) || items.length === 0) {
                tbody.innerHTML = `<tr>
                    <td>1</td>
                    <td>فروش کالا / خدمات طبق فاکتور شماره ${number || id}</td>
                    <td>1</td>
                    <td class="font-monospace">${Number(total || 0).toLocaleString('fa-IR')}</td>
                    <td>0</td>
                    <td>0</td>
                    <td class="font-monospace fw-bold">${Number(total || 0).toLocaleString('fa-IR')}</td>
                </tr>`;
            } else {
                tbody.innerHTML = items.map((it, idx) => {
                    const title = it.product?.productTitle || it.productTitle || it.productName || ('کالای #' + it.productId);
                    const qty = it.quantity || it.count || 1;
                    const unit = it.unitPriceSell ?? it.unitPrice ?? it.price ?? 0;
                    const disc = it.discount ?? 0;
                    const taxVal = it.tax ?? it.vatAmount ?? 0;
                    const rowTotal = it.lineTotal ?? it.totalPrice ?? it.rowSum ?? ((qty * unit) - disc + taxVal);
                    return `
                    <tr>
                        <td>${idx + 1}</td>
                        <td>${title}</td>
                        <td class="font-monospace">${qty}</td>
                        <td class="font-monospace">${Number(unit).toLocaleString('fa-IR')}</td>
                        <td class="font-monospace">${Number(disc).toLocaleString('fa-IR')}</td>
                        <td class="font-monospace">${Number(taxVal).toLocaleString('fa-IR')}</td>
                        <td class="font-monospace fw-bold">${Number(rowTotal).toLocaleString('fa-IR')}</td>
                    </tr>`;
                }).join('');
            }
        })
        .catch(() => {
            tbody.innerHTML = '<tr><td colspan="7" class="py-3 text-danger text-center">خطا در بارگذاری اقلام فاکتور از سرور.</td></tr>';
            SwalHelper.error("خطا در بارگذاری ریز اقلام فاکتور از سرور.");
        });
    }
</script>

@section AdminScripts {
    
    <script>
        function confirmInvoice(invoiceId) {
        swal.fire({
            title: "تأیید فاکتور",
            text: "آیا از تبدیل پیش‌فاکتور به فاکتور نهایی مطمئن هستید؟",
            icon: "warning",
            showCancelButton: true,
            allowOutsideClick: false,
            confirmButtonColor: "green",
            cancelButtonColor: "#d33",
            confirmButtonText: "بله، تأیید شود",
            cancelButtonText: "انصراف"
        }).then(function (result) {

                if (!result.value)
                    return false;

                var formData = new FormData();
                formData.append("invoiceId", invoiceId);
                console.log("Submitting confirmation:", invoiceId);
                $.ajax({
                    type: 'POST',
                    url: '@ApiAddress' + 'SalesInvoice/ConfirmInvoice',
                    processData: false,
                    contentType: false,
                    dataType: 'json',
                    data: formData,
                    headers: {
                        "Authorization": "Bearer " + "@User.FindFirstValue("Token")"
                    },
                    success: function (xhr) {

                        if (xhr.statusCode == 200) {
                            swal.fire({
                                title: "تأیید فاکتور",
                                text: "فاکتور با موفقیت نهایی شد!",
                                icon: "success",
                                showCancelButton: false,
                                showConfirmButton: true,
                                allowOutsideClick: false,
                                confirmButtonColor: "green",
                                confirmButtonText: "باشه"                            
                            });
                            setTimeout(function () {
                                window.location.reload();
                            }, 1500);
                        }

                        else if (xhr.statusCode == 400) {
                            swal.fire({
                                title: "خطا",
                                text: "پارامترهای ارسالی معتبر نیست!",
                                icon: "error",
                                showCancelButton: false,
                                showConfirmButton: true,
                                allowOutsideClick: false,
                                confirmButtonColor: "green",
                                confirmButtonText: "باشه"
                            });
                            return false;
                        }

                        else if (xhr.statusCode == 404) {
                            swal.fire({
                                title: "خطا",
                                text: "فاکتور مورد نظر یافت نشد!",
                                icon: "error",
                                showCancelButton: false,
                                showConfirmButton: true,
                                allowOutsideClick: false,
                                confirmButtonColor: "green",
                                confirmButtonText: "باشه",
                                timer: 1500
                            });
                            return false;
                        }
                        else if (xhr.statusCode == 409) {
                            swal.fire({
                                title: "خطا",
                                text: "این فاکتور قبلاً نهایی شده است!",
                                icon: "error",
                                showCancelButton: false,
                                showConfirmButton: true,
                                allowOutsideClick: false,
                                confirmButtonColor: "green",
                                confirmButtonText: "باشه"                            
                            });
                            return false;
                        }
                        else if (xhr.statusCode == 500) {
                            swal.fire({
                                title: "خطا",
                                text: "خطایی در انجام عملیات رخ داده است!",
                                icon: "error",
                                showCancelButton: false,
                                showConfirmButton: true,
                                allowOutsideClick: false,
                                confirmButtonColor: "green",
                                confirmButtonText: "باشه"                            
                            });

                            return false;
                        }
                    },
                    error: function (err) {
                        swal.fire({
                            title: "خطا",
                            text: err.responseText || "خطایی در ارتباط با سرور رخ داده است!",
                            icon: "error",
                            showCancelButton: false,
                            showConfirmButton: true,
                            allowOutsideClick: false,
                            confirmButtonColor: "green",
                            confirmButtonText: "باشه"
                        });
                    }
                });

            });
        }
    </script>
    <script>
        function showInvoiceDetail(invoiceId) {

            $.ajax({
                type: 'GET',
                url: '@ApiAddress' + 'SalesInvoice/GetInvoiceDetail?invoiceId=' + invoiceId,
                dataType: 'json',
                headers: {
                    "Authorization": "Bearer " + "@User.FindFirstValue("Token")"
                },
                success: function (xhr) {

                    if (xhr.statusCode == 200) {

                        const items = xhr.data;

                        if (!items || items.length === 0) {
                                    swal.fire({
            title: "جزئیات فاکتور",
            text: "آیتمی برای این فاکتور ثبت نشده است!",
            icon: "warning",
            showCancelButton: false,
            showConfirmButton: true,
            allowOutsideClick: false,
            confirmButtonColor: "green",
            confirmButtonText: "باشه",
            timer: 1500
        });
                            return false;
                        }

                        let itemsHtml = '';

                        items.forEach(item => {

                            itemsHtml +=
                                "<tr>" +
                                "<td>" + item.productId + "</td>" +
                                "<td>" + item.quantity + "</td>" +
                                "<td>" + item.unitPriceSell.toLocaleString() + "</td>" +
                                "<td>" + item.lineTotal.toLocaleString() + "</td>" +
                                "</tr>";

                        });

                                swal.fire({
            title: "جزئیات آیتم‌های فاکتور",
            html:
                "<div class='table-responsive'>" +
                "<table class='table table-bordered text-center'>" +
                "<thead>" +
                "<tr>" +
                "<th>شناسه محصول</th>" +
                "<th>تعداد</th>" +
                "<th>قیمت واحد</th>" +
                "<th>جمع</th>" +
                "</tr>" +
                "</thead>" +
                "<tbody>" +
                itemsHtml +
                "</tbody>" +
                "</table>" +
                "</div>",
            icon: "info",
            showCancelButton: false,
            showConfirmButton: true,
            allowOutsideClick: false,
            confirmButtonColor: "green",
            confirmButtonText: "باشه",
            width: "700px"
        });
                    }

                    else if (xhr.statusCode == 400) {
                                swal.fire({
            title: "خطا",
            text: "پارامترهای ارسالی معتبر نیست!",
            icon: "error",
            showCancelButton: false,
            showConfirmButton: true,
            allowOutsideClick: false,
            confirmButtonColor: "green",
            confirmButtonText: "باشه",
            timer: 1500
        });
                        return false;
                    }

                    else if (xhr.statusCode == 404) {
                                swal.fire({
            title: "خطا",
            text: "جزئیات فاکتور مورد نظر یافت نشد!",
            icon: "error",
            showCancelButton: false,
            showConfirmButton: true,
            allowOutsideClick: false,
            confirmButtonColor: "green",
            confirmButtonText: "باشه",
            timer: 1500
        });
                        return false;
                    }

                    else if (xhr.statusCode == 500) {
                                swal.fire({
            title: "خطا",
            text: "خطایی در دریافت اطلاعات فاکتور رخ داده است!",
            icon: "error",
            showCancelButton: false,
            showConfirmButton: true,
            allowOutsideClick: false,
            confirmButtonColor: "green",
            confirmButtonText: "باشه",
            timer: 1500
        });
                        return false;
                    }
                },
                error: function (err) {
                    SwalHelper.error(err.responseText || "خطایی در ارتباط با سرور رخ داده است!");
                }
            });
        }
    </script>

<!-- Modal: Invoice Pattern Customizer -->
<div class="modal fade" id="invoicePatternModal" tabindex="-1" aria-labelledby="invoicePatternModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="invoicePatternModalLabel">شخصی‌سازی الگوی شماره‌گذاری خودکار فاکتورها</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3" style="font-size:13px;">
                    می‌توانید الگوی پیش‌فرض شماره‌گذاری فاکتورهای فروش، خرید و مرجوعی را متناسب با ساختار سازمانی خود شخصی‌سازی کنید.
                </p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label font-weight-bold">الگوی فاکتور فروش (Sales)</label>
                        <input type="text" id="patternSales" class="form-control text-start font-monospace" placeholder="INV-{YEAR}-{SEQ:4}">
                        <small class="text-success d-block mt-1" id="previewSales">پیش‌نمایش: INV-2026-0001</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label font-weight-bold">الگوی فاکتور خرید (Purchase)</label>
                        <input type="text" id="patternPurchase" class="form-control text-start font-monospace" placeholder="PINV-{YEAR}-{SEQ:4}">
                        <small class="text-success d-block mt-1" id="previewPurchase">پیش‌نمایش: PINV-2026-0001</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label font-weight-bold">الگوی برگشت از فروش (Sales Return)</label>
                        <input type="text" id="patternSalesReturn" class="form-control text-start font-monospace" placeholder="SRI-{YEAR}-{SEQ:4}">
                        <small class="text-success d-block mt-1" id="previewSalesReturn">پیش‌نمایش: SRI-2026-0001</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label font-weight-bold">الگوی برگشت از خرید (Purchase Return)</label>
                        <input type="text" id="patternPurchaseReturn" class="form-control text-start font-monospace" placeholder="PRI-{YEAR}-{SEQ:4}">
                        <small class="text-success d-block mt-1" id="previewPurchaseReturn">پیش‌نمایش: PRI-2026-0001</small>
                    </div>
                </div>

                <div class="card mt-3 bg-light border-0">
                    <div class="card-body p-3">
                        <h6 class="card-title text-primary mb-2" style="font-size:13px;">راهنمای متغیرهای الگو (Tokens):</h6>
                        <div class="row text-muted" style="font-size:12px;">
                            <div class="col-6"><code>{PREFIX}</code> پیشوند سند (INV, PINV, ...)</div>
                            <div class="col-6"><code>{YEAR}</code> سال ۴ رقمی (مثلاً 2026)</div>
                            <div class="col-6"><code>{YY}</code> سال ۲ رقمی (مثلاً 26)</div>
                            <div class="col-6"><code>{MONTH}</code> ماه ۲ رقمی (01-12)</div>
                            <div class="col-6"><code>{DAY}</code> روز ۲ رقمی (01-31)</div>
                            <div class="col-6"><code>{SEQ:4}</code> شماره ترتیبی با ۴ رقم (0001)</div>
                            <div class="col-12 mt-1"><code>{TENANT}</code> کد اختصاصی مستاجر / شرکت</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" onclick="saveInvoicePatterns()">ذخیره الگوها</button>
            </div>
        </div>
    </div>
</div>

<script>
function renderPatternPreview(pattern, prefixDefault) {
    if (!pattern) return '';
    const now = new Date();
    const year = now.getFullYear().toString();
    const yy = year.substring(2);
    const month = String(now.getMonth() + 1).padStart(2, '0');
    const day = String(now.getDate()).padStart(2, '0');

    let out = pattern
        .replace('{PREFIX}', prefixDefault)
        .replace('{YEAR}', year)
        .replace('{YY}', yy)
        .replace('{MONTH}', month)
        .replace('{DAY}', day)
        .replace('{TENANT}', 'ACME');

    out = out.replace(/\{SEQ:?(\d*)\}/g, function(match, digits) {
        const d = parseInt(digits) || 4;
        return '1'.padStart(d, '0');
    });
    return out;
}

function updatePatternPreviews() {
    const s = $('#patternSales').val() || 'INV-{YEAR}-{SEQ:4}';
    const p = $('#patternPurchase').val() || 'PINV-{YEAR}-{SEQ:4}';
    const sr = $('#patternSalesReturn').val() || 'SRI-{YEAR}-{SEQ:4}';
    const pr = $('#patternPurchaseReturn').val() || 'PRI-{YEAR}-{SEQ:4}';

    $('#previewSales').text('پیش‌نمایش: ' + renderPatternPreview(s, 'INV'));
    $('#previewPurchase').text('پیش‌نمایش: ' + renderPatternPreview(p, 'PINV'));
    $('#previewSalesReturn').text('پیش‌نمایش: ' + renderPatternPreview(sr, 'SRI'));
    $('#previewPurchaseReturn').text('پیش‌نمایش: ' + renderPatternPreview(pr, 'PRI'));
}

$('#patternSales, #patternPurchase, #patternSalesReturn, #patternPurchaseReturn').on('input', updatePatternPreviews);

function loadInvoicePatterns() {
    $.ajax({
        url: ('@ViewBag.ApiAddress'.endsWith('/') ? '@ViewBag.ApiAddress' : '@ViewBag.ApiAddress/') + 'Tenant/GetInvoicePatterns',
        type: 'GET',
        headers: { 'Authorization': 'Bearer @ViewBag.Token' },
        success: function(res) {
            const d = res?.data ?? res ?? {};
            $('#patternSales').val(d.salesInvoicePattern || 'INV-{YEAR}-{SEQ:4}');
            $('#patternPurchase').val(d.purchaseInvoicePattern || 'PINV-{YEAR}-{SEQ:4}');
            $('#patternSalesReturn').val(d.salesReturnPattern || 'SRI-{YEAR}-{SEQ:4}');
            $('#patternPurchaseReturn').val(d.purchaseReturnPattern || 'PRI-{YEAR}-{SEQ:4}');
            updatePatternPreviews();
        },
        error: function() {
            $('#patternSales').val('INV-{YEAR}-{SEQ:4}');
            $('#patternPurchase').val('PINV-{YEAR}-{SEQ:4}');
            $('#patternSalesReturn').val('SRI-{YEAR}-{SEQ:4}');
            $('#patternPurchaseReturn').val('PRI-{YEAR}-{SEQ:4}');
            updatePatternPreviews();
        }
    });
}

function saveInvoicePatterns() {
    const data = {
        salesInvoicePattern: $('#patternSales').val().trim() || 'INV-{YEAR}-{SEQ:4}',
        purchaseInvoicePattern: $('#patternPurchase').val().trim() || 'PINV-{YEAR}-{SEQ:4}',
        salesReturnPattern: $('#patternSalesReturn').val().trim() || 'SRI-{YEAR}-{SEQ:4}',
        purchaseReturnPattern: $('#patternPurchaseReturn').val().trim() || 'PRI-{YEAR}-{SEQ:4}'
    };

    $.ajax({
        url: ('@ViewBag.ApiAddress'.endsWith('/') ? '@ViewBag.ApiAddress' : '@ViewBag.ApiAddress/') + 'Tenant/UpdateInvoicePatterns',
        type: 'PUT',
        contentType: 'application/json',
        data: JSON.stringify(data),
        headers: { 'Authorization': 'Bearer @ViewBag.Token' },
        success: function() {
            var modalEl = document.getElementById('invoicePatternModal');
            if (window.bootstrap && bootstrap.Modal) {
                var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                modal.hide();
            } else {
                $('#invoicePatternModal').modal('hide');
            }
            swal.fire({
                title: "موفقیت‌آمیز",
                text: "الگوهای شماره‌گذاری فاکتورها با موفقیت به‌روزرسانی شد.",
                icon: "success",
                timer: 2000,
                showConfirmButton: false
            });
        },
        error: function(xhr) {
            swal.fire({
                title: "خطا",
                text: xhr.responseText || "خطایی در ذخیره الگوها رخ داد.",
                icon: "error",
                confirmButtonText: "باشه"
            });
        }
    });
}

$(document).ready(function () {
    const apiBase = ('@ViewBag.ApiAddress'.endsWith('/') ? '@ViewBag.ApiAddress' : '@ViewBag.ApiAddress/');
    const token = '@ViewBag.Token';
    if (!token) return;

    fetch(apiBase + 'SalesInvoice/SettlementSummaries', {
        headers: { 'Authorization': 'Bearer ' + token }
    })
    .then(r => r.json())
    .then(res => {
        const list = res.data || [];
        const map = {};
        list.forEach(s => { const key = s.salesInvoiceId ?? s.referenceId; if (key) map[key] = s; });

        document.querySelectorAll('.si-paid-cell').forEach(cell => {
            const id = Number(cell.getAttribute('data-inv-id'));
            const st = Number(cell.getAttribute('data-status'));
            const s = map[id];
            if (!s) { cell.textContent = '0'; return; }
            if (st === 0) {
                cell.innerHTML = '<span class="text-muted">پیش‌فاکتور</span>';
                return;
            }
            const cash = Number(s.cashPaidAmount || 0);
            const pend = Number(s.pendingChequesAmount || 0);
            const clrd = Number(s.clearedChequesAmount || 0);
            const bncd = Number(s.bouncedChequesAmount || 0);
            let parts = [];
            if (cash > 0) parts.push(`<div class="text-success">نقد/بانک: ${cash.toLocaleString('fa-IR')}</div>`);
            if (pend > 0) parts.push(`<div class="text-primary">چک در جریان: ${pend.toLocaleString('fa-IR')}</div>`);
            if (clrd > 0) parts.push(`<div class="text-success">چک وصول‌شده: ${clrd.toLocaleString('fa-IR')}</div>`);
            if (bncd > 0) parts.push(`<div class="text-danger">چک برگشتی: ${bncd.toLocaleString('fa-IR')}</div>`);
            cell.innerHTML = parts.length > 0 ? parts.join('') : '<span class="text-muted">0</span>';
        });

        document.querySelectorAll('.si-rem-cell').forEach(cell => {
            const id = Number(cell.getAttribute('data-inv-id'));
            const st = Number(cell.getAttribute('data-status'));
            const s = map[id];
            if (!s) { cell.textContent = '-'; return; }
            if (st === 0) {
                cell.innerHTML = '<span class="badge bg-info text-dark">در انتظار نهایی‌سازی</span>';
                return;
            }
            const rem = Number(s.remainingAmount || 0);
            const badge = s.settlementStatus === 3
                ? '<span class="badge bg-success">تسویه کامل</span>'
                : s.settlementStatus === 2
                    ? '<span class="badge bg-warning text-dark">تسویه جزئی</span>'
                    : '<span class="badge bg-danger">پرداخت‌نشده</span>';
            cell.innerHTML = `<div class="fw-bold ${rem > 0 ? 'text-danger' : 'text-success'}" dir="ltr">${rem.toLocaleString('fa-IR')}</div>${badge}`;
        });
    })
    .catch(() => {
        document.querySelectorAll('.si-paid-cell, .si-rem-cell').forEach(c => { c.textContent = '-'; });
    });
});
</script>
}