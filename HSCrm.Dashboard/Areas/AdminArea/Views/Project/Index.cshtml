@using HSCrm.Dashboard.Costants
@model IEnumerable<ProjectModel>

@{
    ViewData["Title"] = "پروژه ها";
    ViewData["selected"] = "project_list";

    string ApiAddress = ViewBag.ApiAddress;

    List<CustomersDropDown> lstCustomer = ViewBag.Customers ?? new List<CustomersDropDown>();
    if (!lstCustomer.Any(c => c.DrId == "0"))
    {
        lstCustomer.Insert(0, new CustomersDropDown { DrId = "0", DrName = "انتخاب مشتری" });
    }
}

@section styles {
    <link href="~/assets/plugins/data-tables/datatables.bootstrap5.min.css" rel="stylesheet">
    <link href="~/assets/plugins/data-tables/responsive.datatables.min.css" rel="stylesheet">
    <link href="~/assets/css/ekka.css" id="ekka-css" rel="stylesheet">
    <link href="~/lib/persiandate/persian-datepicker.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper breadcrumb-contacts">
    <div>
        <h1>لیست پروژه‌ها</h1>
        <p class="breadcrumbs"><span><a href="/AdminArea/Home/Index">خانه</a></span> <span><i class="mdi mdi-chevron-left"></i></span>پروژه</p>
    </div>
    @if (ViewBag.FiscalYearStatus == "0")
    {
        <div>
            @if (User.HasPermission(Permissions.Projects.Create))
            {
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addProject"> اضافه کردن پروژه </button>
            }
        </div>
    }
</div>
@if (ViewBag.FiscalYearStatus != "0")
{
    <div class="alert alert-primary col-lg-8" role="alert" style="margin-top:40px; color:#084298;">
        توجه!
        <br>
        سال مالی انتخاب شده بسته می باشد! شما فقط قادر به مشاهده گزارشات سیستم هستید.
    </div>
}
<div class="row">
    <div class="col-12">
        <div class="ec-vendor-list card card-default">
            <div class="card-body">
                <div class="table-responsive-md">
                    <div id="responsive-data-table_wrapper" class="dataTables_wrapper dt-bootstrap5 no-footer">
                        <table id="responsive-data-table" class="table dataTable no-footer" aria-describedby="responsive-data-table_info">
                            <thead>
                                <tr>
                                    <th>عنوان پروژه</th>
                                    <th>مشتری</th>
                                    <th>شماره تماس مشتری</th>
                                    <th>محل پروژه</th>
                                    <th>اعضای تیم</th>
                                    <th>وضعیت</th>
                                    <th>فعالیت</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.ProjectTitle</td>
                                        <td>@(item.Customer?.Name ?? "-")</td>
                                        <td>@(item.Customer?.Phone ?? "-")</td>
                                        <td>@item.ProjectLocation</td>
                                        <td>
                                            <span class="badge bg-info text-dark project-member-count-badge" data-project-id="@item.Id" style="cursor:pointer;"
                                                  onclick="openProjectMembersModal(@item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.ProjectTitle ?? ""))')">
                                                0 عضو
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge @(item.Status == "Active" ? "bg-success" : "bg-danger")">
                                                @(item.Status == "Active" ? "فعال" : "اتمام پروژه")
                                            </span>
                                        </td>
                                        <td>
                                            <div class="btn-group mb-1">
                                                <button type="button" class="btn btn-outline-primary btn-sm" onclick="openProjectProfitabilityModal(@item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.ProjectTitle ?? ""))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Customer?.Name ?? ""))')">
                                                    <i class="mdi mdi-finance me-1"></i>کارنامه سود و زیان پروژه
                                                </button>
                                                <button type="button" class="btn btn-outline-success">اطلاعات</button>
                                                <button type="button" class="btn btn-outline-success dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-display="static">
                                                    <span class="sr-only">اطلاعات</span>
                                                </button>
                                                <div class="dropdown-menu">
                                                    @if (ViewBag.FiscalYearStatus == "0")
                                                    {
                                                        @if (User.HasPermission(Permissions.Projects.Edit))
                                                        {
                                                            <a class="dropdown-item" href="#" onclick="showUpdateModal(@item.Id)">ویرایش</a>
                                                        }
                                                        @if (User.HasPermission(Permissions.Projects.Delete))
                                                        {
                                                            <a class="dropdown-item" href="#">حذف</a>
                                                        }
                                                        <div class="dropdown-divider"></div>
                                                    }
                                                    @if (User.HasPermission(Permissions.ProjectMembers.View) || User.HasPermission(Permissions.ProjectMembers.Manage))
                                                    {
                                                        <a class="dropdown-item text-primary" href="javascript:void(0)" onclick="openProjectMembersModal(@item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.ProjectTitle ?? ""))')">
                                                            <i class="mdi mdi-account-multiple-plus me-1"></i>مدیریت اعضای تیم
                                                        </a>
                                                    }
                                                    @if (User.HasPermission(Permissions.WorkLogs.View))
                                                    {
                                                        <a class="dropdown-item text-info" href="/AdminArea/ProjectWorkLog/Index?projectId=@item.Id">
                                                            <i class="mdi mdi-clock-outline me-1"></i>ساعات کاری پروژه
                                                        </a>
                                                    }
                                                    @if (User.HasPermission(Permissions.Expenses.View))
                                                    {
                                                        <a class="dropdown-item" href="/adminarea/expense/projectexpenses?projectId=@item.Id">مشاهده هزینه ها</a>
                                                    }
                                                    @if (User.HasPermission(Permissions.SalesInvoices.View))
                                                    {
                                                        <a class="dropdown-item" href="/adminarea/Invoice/ProjectInvoices?projectId=@item.Id">مشاهده فاکتورها</a>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@if (ViewBag.FiscalYearStatus == "0")
{
    <div class="modal fade modal-add-contact" id="addProject" tabindex="-1" role="dialog" aria-labelledby="addProjectModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <form id="frmProject">
                    <div class="modal-header px-4">
                        <h5 class="modal-title" id="addProjectModalTitle">تعریف پروژه جدید</h5>
                    </div>
                    <div class="modal-body px-4">
                        <div class="row mb-2">
                            <div class="col-lg-6">
                                <div class="form-group form-floating">
                                    <input class="form-control text-end" id="ProjectTitle" name="ProjectTitle" placeholder="عنوان پروژه">
                                    <label for="ProjectTitle" style="right:0!important; left:unset!important;">عنوان پروژه</label>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-floating">
                                    <select style="border-radius: 15px; border: 1px solid #f3f3f3;" class="form-select text-end" id="CustomerId" name="CustomerId" asp-items="@(new SelectList(lstCustomer, "DrId", "DrName"))">
                                        <option value="">انتخاب مشتری</option>
                                    </select>
                                    <label for="CustomerId" style="right:0!important; left:unset!important;">
                                        انتخاب مشتری
                                    </label>
                                </div>

                            </div>
                            <div class="col-lg-12">
                                <div class="form-group form-floating">
                                    <input class="form-control text-end" id="ProjectLocation" name="ProjectLocation" placeholder="محل پروژه">
                                    <label for="ProjectLocation" style="right:0!important; left:unset!important;">محل پروژه</label>
                                </div>
                            </div>
                            <input hidden class="form-control text-end" id="CreateById" name="CreateById" value="@ViewBag.UserId">
                            <input hidden class="form-control text-end" id="TenantId" name="TenantId" value="@ViewBag.TenantId">
                            <div class="col-lg-12 alert" style="color:red">
                                <span class="text-danger" id="spnValidateAddProject"></span>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer px-4">
                        <button type="button" class="btn btn-secondary btn-pill" data-bs-dismiss="modal">
                            لغو
                        </button>
                        <button id="btnProjectSubmit" type="button" class="btn btn-primary btn-pill">ذخیره </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal fade modal-add-contact" id="editProject" tabindex="-1" role="dialog" aria-labelledby="editProjectModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <form id="frmEditProject">
                    <div class="modal-header px-4">
                        <h5 class="modal-title" id="editProjectModalTitle">ویرایش پروژه</h5>
                    </div>
                    <div class="modal-body px-4">
                        <div class="row mb-2">
                            <div class="col-lg-6">
                                <div class="form-group form-floating">
                                    <input id="PId" name="PId" hidden />
                                    <input class="form-control text-end" id="ProjectTitleE" name="ProjectTitleE" placeholder="عنوان پروژه">
                                    <label for="ProjectTitleE" style="right:0!important; left:unset!important;">عنوان پروژه</label>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-floating">
                                    <select style="border-radius: 15px; border: 1px solid #f3f3f3;" class="form-select text-end" id="CustomerIdE" name="CustomerIdE" asp-items="@(new SelectList(lstCustomer, "DrId", "DrName"))">
                                        <option value="">انتخاب مشتری</option>
                                    </select>
                                    <label for="CustomerIdE" style="right:0!important; left:unset!important;">
                                        انتخاب مشتری
                                    </label>
                                </div>

                            </div>
                            <div class="col-lg-12">
                                <div class="form-group form-floating">
                                    <input class="form-control text-end" id="ProjectLocationE" name="ProjectLocationE" placeholder="محل پروژه">
                                    <label for="ProjectLocationE" style="right:0!important; left:unset!important;">محل پروژه</label>
                                </div>
                            </div>
                            <input hidden class="form-control text-end" id="ModifiedById" name="ModifiedById" value="@ViewBag.UserId">
                            <div class="col-lg-12 alert" style="color:red">
                                <span class="text-danger" id="spnValidateEditProject"></span>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer px-4">
                        <button type="button" class="btn btn-secondary btn-pill" data-bs-dismiss="modal">
                            لغو
                        </button>
                        <button id="btnProjectUpdate" type="button" class="btn btn-primary btn-pill">ذخیره </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}


<!-- مودال کارنامه مالی و سود و زیان تفکیکی پروژه -->
<div class="modal fade" id="projectProfitabilityModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="modal-title">
                    <i class="mdi mdi-briefcase-check-outline me-1 text-warning"></i>
                    کارنامه مالی و صورت سود و زیان پروژه: <span id="pfTitle" class="text-warning"></span>
                </h5>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-light" onclick="window.print()">
                        <i class="mdi mdi-printer me-1"></i>چاپ کارنامه پروژه (A4)
                    </button>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="p-3 rounded bg-light border-start border-4 border-primary">
                            <div class="text-muted small">جمع فاکتورهای فروش پروژه</div>
                            <h5 class="fw-bold text-primary font-monospace mb-0" id="pfTotalSales">0</h5>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 rounded bg-light border-start border-4 border-danger">
                            <div class="text-muted small">جمع هزینه‌های مستقیم پروژه</div>
                            <h5 class="fw-bold text-danger font-monospace mb-0" id="pfTotalExpenses">0</h5>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 rounded bg-light border-start border-4 border-success">
                            <div class="text-muted small">سود / زیان خالص پروژه</div>
                            <h5 class="fw-bold text-success font-monospace mb-0" id="pfNetProfit">0</h5>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 rounded bg-light border-start border-4 border-info">
                            <div class="text-muted small">حاشیه سود پروژه (Margin)</div>
                            <h5 class="fw-bold text-info font-monospace mb-0" id="pfMarginPct">0%</h5>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-lg-6">
                        <h6 class="fw-bold border-bottom pb-2"><i class="mdi mdi-file-document-outline me-1 text-primary"></i>فاکتورهای فروش ثبت‌شده برای این پروژه</h6>
                        <div class="table-responsive" style="max-height: 280px;">
                            <table class="table table-sm table-bordered align-middle small">
                                <thead class="table-light">
                                    <tr>
                                        <th>شماره فاکتور</th>
                                        <th>وضعیت</th>
                                        <th class="text-end">مبلغ کل (ریال)</th>
                                    </tr>
                                </thead>
                                <tbody id="pfInvoicesBody"></tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <h6 class="fw-bold border-bottom pb-2"><i class="mdi mdi-cash-remove me-1 text-danger"></i>هزینه‌های ثبت‌شده برای این پروژه</h6>
                        <div class="table-responsive" style="max-height: 280px;">
                            <table class="table table-sm table-bordered align-middle small">
                                <thead class="table-light">
                                    <tr>
                                        <th>عنوان هزینه</th>
                                        <th>توضیحات</th>
                                        <th class="text-end">مبلغ (ریال)</th>
                                    </tr>
                                </thead>
                                <tbody id="pfExpensesBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function openProjectProfitabilityModal(projectId, projectTitle, customerName) {
        document.getElementById('pfTitle').textContent = `${projectTitle} (${customerName || 'بدون مشتری'})`;
        const modal = new bootstrap.Modal(document.getElementById('projectProfitabilityModal'));
        modal.show();

        const apiAddr = '@ApiAddress'.replace(/\/+$/, '');
        const headers = { 'Authorization': 'Bearer ' + '@User.FindFirstValue("Token")' };

        try {
            const [invRes, expRes] = await Promise.all([
                fetch(`${apiAddr}/SalesInvoice/GetProjectInvoices?projectId=${projectId}`, { headers }).then(r => r.json()).catch(() => ({ data: [] })),
                fetch(`${apiAddr}/Expense/GetProjectExpenses?projectId=${projectId}`, { headers }).then(r => r.json()).catch(() => ({ data: [] }))
            ]);

            const invoices = invRes.data || invRes || [];
            const expenses = expRes.data || expRes || [];

            const totalSales = Array.isArray(invoices)
                ? invoices.reduce((s, x) => s + (x.totalAmount ?? x.total ?? x.finalAmount ?? 0), 0)
                : 0;
            const totalExp = Array.isArray(expenses)
                ? expenses.reduce((s, x) => s + (x.amount ?? 0), 0)
                : 0;
            const netProfit = totalSales - totalExp;
            const margin = totalSales > 0 ? Math.round((netProfit / totalSales) * 100) : 0;

            document.getElementById('pfTotalSales').textContent = Number(totalSales).toLocaleString('fa-IR') + ' ریال';
            document.getElementById('pfTotalExpenses').textContent = Number(totalExp).toLocaleString('fa-IR') + ' ریال';
            document.getElementById('pfNetProfit').textContent = Number(netProfit).toLocaleString('fa-IR') + ' ریال';
            document.getElementById('pfNetProfit').className = 'fw-bold font-monospace mb-0 ' + (netProfit >= 0 ? 'text-success' : 'text-danger');
            document.getElementById('pfMarginPct').textContent = margin + '%';

            const invBody = document.getElementById('pfInvoicesBody');
            if (!Array.isArray(invoices) || invoices.length === 0) {
                invBody.innerHTML = '<tr><td colspan="3" class="text-center text-muted py-2">فاکتور فروشی برای این پروژه ثبت نشده است.</td></tr>';
            } else {
                invBody.innerHTML = invoices.map(i => `
                    <tr>
                        <td class="font-monospace">#${i.invoiceNumber || i.number || i.id}</td>
                        <td><span class="badge ${i.status === 1 ? 'bg-success' : 'bg-warning text-dark'}">${i.status === 1 ? 'نهایی' : 'پیش‌فاکتور'}</span></td>
                        <td class="text-end font-monospace fw-bold">${Number(i.totalAmount ?? i.total ?? 0).toLocaleString('fa-IR')}</td>
                    </tr>
                `).join('');
            }

            const expBody = document.getElementById('pfExpensesBody');
            if (!Array.isArray(expenses) || expenses.length === 0) {
                expBody.innerHTML = '<tr><td colspan="3" class="text-center text-muted py-2">هزینه‌ای برای این پروژه ثبت نشده است.</td></tr>';
            } else {
                expBody.innerHTML = expenses.map(e => `
                    <tr>
                        <td class="fw-bold">${e.expenseTitle || '-'}</td>
                        <td class="text-muted">${e.description || '-'}</td>
                        <td class="text-end font-monospace fw-bold text-danger">${Number(e.amount || 0).toLocaleString('fa-IR')}</td>
                    </tr>
                `).join('');
            }
        } catch (err) {
            console.error(err);
        }
    }
</script>


<!-- مودال مدیریت اعضای تیم پروژه (فاز ۲) -->
<div class="modal fade" id="projectMembersModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold">
                    <i class="mdi mdi-account-group text-primary me-1"></i>
                    تیم پروژه: <span id="pmProjectTitle" class="text-primary"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="pmProjectId" value="0" />
                @if (User.HasPermission(Permissions.ProjectMembers.Manage))
                {
                    <div class="card border mb-3 bg-light">
                        <div class="card-body py-3">
                            <h6 class="fw-bold mb-3 small text-dark"><i class="mdi mdi-account-plus me-1"></i>افزودن یا ویرایش عضو پروژه</h6>
                            <div class="row g-2 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label small mb-1">کاربر</label>
                                    <select id="pmUserId" class="form-select form-select-sm">
                                        <option value="">-- انتخاب کاربر --</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-1">سمت در پروژه (اختیاری)</label>
                                    <input type="text" id="pmRole" class="form-control form-control-sm" placeholder="مثلاً: تکنسین، سرپرست" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-1">نرخ ساعتی (ریال - اختیاری)</label>
                                    <input type="number" min="0" step="1000" id="pmHourlyRate" class="form-control form-control-sm text-end" placeholder="مثلاً: 2500000" />
                                </div>
                                <div class="col-md-2 d-grid">
                                    <button type="button" id="btnSaveProjectMember" class="btn btn-primary btn-sm" onclick="saveProjectMember()">
                                        <i class="mdi mdi-content-save me-1"></i>ثبت عضو
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-hover align-middle small">
                        <thead class="table-light">
                            <tr>
                                <th>نام و نام خانوادگی</th>
                                <th>نام کاربری</th>
                                <th>سمت در پروژه</th>
                                <th class="text-end">نرخ ساعتی (ریال)</th>
                                <th>تاریخ عضویت</th>
                                <th>وضعیت</th>
                                @if (User.HasPermission(Permissions.ProjectMembers.Manage))
                                {
                                    <th class="text-center">عملیات</th>
                                }
                            </tr>
                        </thead>
                        <tbody id="pmMembersBody">
                            <tr><td colspan="7" class="text-center text-muted py-3">در حال بارگذاری...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const pmApiAddr = '@ApiAddress'.replace(/\/+$/, '');
    const pmToken = '@User.FindFirstValue("Token")';
    const pmCanManage = @((User.HasPermission(Permissions.ProjectMembers.Manage)).ToString().ToLower());
    let pmAssignableUsersLoaded = false;

    async function loadProjectMemberCounts() {
        try {
            const res = await fetch(`${pmApiAddr}/ProjectMember/GetMemberCounts`, {
                headers: { 'Authorization': 'Bearer ' + pmToken }
            });
            if (!res.ok) return;
            const json = await res.json();
            const counts = json.data || {};
            document.querySelectorAll('.project-member-count-badge').forEach(el => {
                const pid = el.getAttribute('data-project-id');
                const cnt = counts[pid] ?? 0;
                el.textContent = `${cnt} عضو`;
                el.className = `badge ${cnt > 0 ? 'bg-info text-dark' : 'bg-secondary'} project-member-count-badge`;
            });
        } catch (err) {
            console.error(err);
        }
    }

    async function loadAssignableUsersOnce() {
        if (!pmCanManage || pmAssignableUsersLoaded) return;
        try {
            const res = await fetch(`${pmApiAddr}/ProjectMember/GetAssignableUsers`, {
                headers: { 'Authorization': 'Bearer ' + pmToken }
            });
            if (!res.ok) return;
            const json = await res.json();
            const users = json.data || [];
            const sel = document.getElementById('pmUserId');
            if (!sel) return;
            sel.innerHTML = '<option value="">-- انتخاب کاربر --</option>';
            users.forEach(u => {
                const opt = document.createElement('option');
                opt.value = u.id;
                opt.textContent = `${u.fullName} (${u.userName})`;
                sel.appendChild(opt);
            });
            pmAssignableUsersLoaded = true;
        } catch (err) {
            console.error(err);
        }
    }

    async function openProjectMembersModal(projectId, projectTitle) {
        document.getElementById('pmProjectId').value = projectId;
        document.getElementById('pmProjectTitle').textContent = projectTitle || ('پروژه #' + projectId);
        if (document.getElementById('pmUserId')) {
            document.getElementById('pmUserId').value = '';
            document.getElementById('pmRole').value = '';
            document.getElementById('pmHourlyRate').value = '';
        }
        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('projectMembersModal'));
        modal.show();
        await Promise.all([loadAssignableUsersOnce(), refreshProjectMembersTable(projectId)]);
    }

    async function refreshProjectMembersTable(projectId) {
        const body = document.getElementById('pmMembersBody');
        body.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3">در حال بارگذاری...</td></tr>';
        try {
            const res = await fetch(`${pmApiAddr}/ProjectMember/GetByProject/${projectId}`, {
                headers: { 'Authorization': 'Bearer ' + pmToken }
            });
            const json = await res.json();
            if (!res.ok || !json.status) {
                body.innerHTML = `<tr><td colspan="7" class="text-center text-danger py-3">${json.message || 'خطا در دریافت اعضای پروژه'}</td></tr>`;
                return;
            }
            const list = json.data || [];
            if (list.length === 0) {
                body.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3">هنوز هیچ کاربری به این پروژه تخصیص نیافته است.</td></tr>';
                return;
            }
            body.innerHTML = list.map(m => {
                const safeRole = (m.projectRole || '').replace(/'/g, "\\'");
                const rateText = m.hourlyRate != null ? Number(m.hourlyRate).toLocaleString('fa-IR') : '-';
                const actionsTd = pmCanManage ? `
                    <td class="text-center text-nowrap">
                        <button type="button" class="btn btn-outline-primary btn-xs py-0 px-2"
                                onclick="prefillMemberForm('${m.userId}', '${safeRole}', '${m.hourlyRate ?? ''}')">ویرایش</button>
                        <button type="button" class="btn btn-outline-danger btn-xs py-0 px-2 ms-1"
                                onclick="removeProjectMember(${m.id})">حذف</button>
                    </td>` : '';
                return `<tr>
                    <td class="fw-bold">${m.fullName}</td>
                    <td class="font-monospace">${m.userName}</td>
                    <td>${m.projectRole || '-'}</td>
                    <td class="text-end font-monospace">${rateText}</td>
                    <td>${m.joinedAtShamsi || '-'}</td>
                    <td><span class="badge ${m.isActive ? 'bg-success' : 'bg-secondary'}">${m.isActive ? 'فعال' : 'غیرفعال'}</span></td>
                    ${actionsTd}
                </tr>`;
            }).join('');
        } catch (err) {
            console.error(err);
            body.innerHTML = '<tr><td colspan="7" class="text-center text-danger py-3">خطا در ارتباط با سرور</td></tr>';
        }
    }

    function prefillMemberForm(userId, role, hourlyRate) {
        if (!pmCanManage) return;
        document.getElementById('pmUserId').value = userId;
        document.getElementById('pmRole').value = role || '';
        document.getElementById('pmHourlyRate').value = hourlyRate !== '' ? hourlyRate : '';
    }

    async function saveProjectMember() {
        const projectId = parseInt(document.getElementById('pmProjectId').value, 10);
        const userId = document.getElementById('pmUserId').value;
        const projectRole = document.getElementById('pmRole').value.trim();
        const rateRaw = document.getElementById('pmHourlyRate').value.trim();
        if (!userId) {
            SwalHelper.warning("لطفاً کاربر را انتخاب نمایید.");
            return;
        }
        const payload = {
            projectId: projectId,
            userId: userId,
            projectRole: projectRole || null,
            hourlyRate: rateRaw !== '' ? parseFloat(rateRaw) : null,
            isActive: true
        };
        try {
            const res = await fetch(`${pmApiAddr}/ProjectMember/AddOrUpdateMember`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + pmToken
                },
                body: JSON.stringify(payload)
            });
            const json = await res.json();
            if (!res.ok || !json.status) {
                SwalHelper.error(json.message || 'خطا در ثبت عضو پروژه');
                return;
            }
            document.getElementById('pmUserId').value = '';
            document.getElementById('pmRole').value = '';
            document.getElementById('pmHourlyRate').value = '';
            await Promise.all([refreshProjectMembersTable(projectId), loadProjectMemberCounts()]);
            SwalHelper.success(json.message || 'عضو پروژه با موفقیت ثبت شد.');
        } catch (err) {
            SwalHelper.error('خطا در ارتباط با سرور');
        }
    }

    async function removeProjectMember(memberId) {
        const projectId = parseInt(document.getElementById('pmProjectId').value, 10);
        const conf = await Swal.fire({
            title: 'حذف عضو از پروژه؟',
            text: 'کاربر پس از حذف دیگر به این پروژه دسترسی نخواهد داشت.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            confirmButtonText: 'بله، حذف شود',
            cancelButtonText: 'انصراف'
        });
        if (!conf.isConfirmed) return;
        try {
            const res = await fetch(`${pmApiAddr}/ProjectMember/RemoveMember/${memberId}`, {
                method: 'DELETE',
                headers: { 'Authorization': 'Bearer ' + pmToken }
            });
            const json = await res.json();
            if (!res.ok || !json.status) {
                SwalHelper.error(json.message || 'خطا در حذف عضو');
                return;
            }
            await Promise.all([refreshProjectMembersTable(projectId), loadProjectMemberCounts()]);
            SwalHelper.success(json.message || 'عضو از تیم پروژه حذف شد.');
        } catch (err) {
            SwalHelper.error('خطا در ارتباط با سرور');
        }
    }

    document.addEventListener('DOMContentLoaded', loadProjectMemberCounts);
</script>

@section AdminScripts {
    <script>
        $("#btnProjectSubmit").on('click', function (e) {
            e.preventDefault();
            var title = $("#ProjectTitle").val();
            if (!title || title.trim() === "") {
                SwalHelper.warning("لطفاً عنوان پروژه را وارد نمایید!");
                return false;
            }
            var formData = new FormData($("#frmProject")[0]);
            $.ajax({
                type: 'POST',
                url: '@ApiAddress' + 'Project/CreateProject',
                processData: false,
                contentType: false,
                dataType: "json",
                data: formData,
                headers: {
                    Authorization: 'Bearer ' + '@User.FindFirstValue("Token")'
                },
                success: function (xhr) {
                    SwalHelper.handleResponse(xhr, "ثبت پروژه با موفقیت انجام شد!", function () {
                        $('#addProject').modal('hide');
                        $('#ProjectTitle').val("");
                        $('#CustomerId').val("");
                        $('#ProjectLocation').val("");
                        window.location.reload();
                    });
                },
                error: function (xhr) {
                    var msg = (xhr.responseJSON && xhr.responseJSON.message) || "خطا در ثبت پروژه";
                    SwalHelper.error(msg);
                }
            });
        });
    </script>
    <script>
        function showUpdateModal(projectId) {
            $.ajax({
                type: 'GET',
                url: '@ApiAddress' + 'Project/GetById?projectId=' + projectId,
                dataType: 'json',
                headers: {
                    Authorization: 'Bearer ' + '@User.FindFirstValue("Token")'
                },
                success: function (xhr) {
                    if (xhr && xhr.data) {
                        const data = xhr.data;
                        $("#PId").val(data.id);
                        $("#ProjectTitleE").val(data.projectTitle);
                        $("#ProjectLocationE").val(data.projectLocation);
                        $("#CustomerIdE").val(data.customerId);
                        $("#editProject").modal('show');
                    } else {
                        SwalHelper.error("اطلاعات پروژه یافت نشد.");
                    }
                },
                error: function () {
                    SwalHelper.error("خطا در بازیابی اطلاعات پروژه.");
                }
            });
        }
        $("#btnProjectUpdate").on('click', function (e) {
            e.preventDefault();
            var title = $("#ProjectTitleE").val();
            if (!title || title.trim() === "") {
                SwalHelper.warning("لطفاً عنوان پروژه را وارد نمایید!");
                return false;
            }
            var model = {
                ProjectId: parseInt($("#PId").val()),
                ProjectTitle: $("#ProjectTitleE").val(),
                CustomerId: $("#CustomerIdE").val() ? parseInt($("#CustomerIdE").val()) : null,
                ProjectLocation: $("#ProjectLocationE").val(),
                ModifiedById: $("#ModifiedById").val()
            };
            $.ajax({
                type: 'PUT',
                url: '@ApiAddress' + 'Project/UpdateProject',
                dataType: 'json',
                contentType: 'application/json',
                data: JSON.stringify(model),
                headers: {
                    Authorization: 'Bearer ' + '@User.FindFirstValue("Token")'
                },
                success: function (xhr) {
                    SwalHelper.handleResponse(xhr, "ویرایش پروژه با موفقیت انجام شد!", function () {
                        $('#editProject').modal('hide');
                        window.location.reload();
                    });
                },
                error: function (xhr) {
                    var msg = (xhr.responseJSON && xhr.responseJSON.message) || "خطا در ویرایش پروژه";
                    SwalHelper.error(msg);
                }
            });
        });
    </script>
}