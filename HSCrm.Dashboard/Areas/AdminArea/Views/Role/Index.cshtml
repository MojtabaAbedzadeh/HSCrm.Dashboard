@model List<HSCrm.Models.ModelDto.RoleModel>

@{
    ViewData["Title"] = "مدیریت نقش‌ها";
    ViewData["selected"] = "role_list";

    string ApiAddress = ViewBag.ApiAddress;
}

<div class="breadcrumb-wrapper breadcrumb-contacts">
    <div>
        <h1>لیست نقش‌ها</h1>
        <p class="breadcrumbs">
            <span>
                <a href="index.html">خانه</a>
            </span>
            <span>
                <i class="mdi mdi-chevron-left"></i>
            </span>نقش
        </p>
    </div>
    <div>
        <a onclick="showInsertRoleModel()" class="btn btn-primary">اضافه کردن نقش</a>
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="ec-vendor-list card card-default">
            <div class="card-body">
                <div class="table-responsive-md">
                    <div id="responsive-data-table_wrapper" class="dataTables_wrapper dt-bootstrap5 no-footer">
                        <table id="responsive-data-table" class="table dataTable no-footer" aria-describedby="responsive-data-table_info">
                            <thead>
                                <tr>
                                    <th>عنوان نقش</th>
                                    <th>فعالیت</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.FaName</td>
                                        <td>
                                            <div class="btn-group mb-1">
                                                <button class="btn btn-outline-success">اطلاعات</button>
                                                <button type="button" class="btn btn-outline-success dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-display="static">
                                                    <span class="sr-only">اطلاعات</span>
                                                </button>
                                                <div class="dropdown-menu">
                                                    @if (item.Name != "Owner")
                                                    {
                                                        <a asp-area="AdminArea" asp-controller="Role" asp-action="Edit" asp-route-id="@item.Id" class="dropdown-item">ویرایش</a>
                                                        <a asp-area="AdminArea" asp-controller="Role" asp-action="ManagePermissions" asp-route-id="@item.Id" class="dropdown-item">دسترسی‌ها</a>
                                                        <a class="dropdown-item" href="#">حذف</a>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-add-contact" id="addRoleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <form id="frmRole">
                <div class="modal-header px-4">
                    <h5 class="modal-title" id="exampleModalCenterTitle">تعریف نقش جدید</h5>
                </div>
                <div class="modal-body px-4">
                    <div class="row mb-2">
                        <div class="col-lg-6">
                            <div class="form-group form-floating">
                                <input class="form-control text-end" id="RoleName" name="RoleName" placeholder="عنوان لاتین نقش">
                                <label for="RoleName" style="right:0!important; left:unset!important; color:#d2d2d2;">عنوان انگلیسی مثال: Employe</label>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="form-group form-floating">
                                <input class="form-control text-end" id="RoleFaName" name="RoleFaName" placeholder="عنوان فارسی نقش">
                                <label for="RoleFaName" style="right:0!important; left:unset!important; color:#d2d2d2;">عنوان فارسی مثال: کارمند</label>
                            </div>
                        </div>
                        <div class="col-lg-12 alert" style="color:red">
                            <span class="text-danger" id="spnValidate"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer px-4">
                    <button type="button" class="btn btn-secondary btn-pill" data-bs-dismiss="modal">
                        لغو
                    </button>
                    <button id="btnRoleSubmit" type="button" class="btn btn-primary btn-pill">ذخیره </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section AdminScripts {
    <script>
        function showInsertRoleModel() {
            $("#addRoleModal").modal('show');
        }
        $("#btnRoleSubmit").on('click', function (e) {
            e.preventDefault();
            var Name = $("#RoleName").val();
            var FaName = $("#RoleFaName").val();
            if (!Name || Name.trim() === "") {
                SwalHelper.warning("عنوان لاتین نقش را وارد نمایید!");
                return false;
            }
            if (!FaName || FaName.trim() === "") {
                SwalHelper.warning("عنوان فارسی نقش را وارد نمایید!");
                return false;
            }
            var model = {
                name: $("#RoleName").val(),
                faName: $("#RoleFaName").val()
            };
            $.ajax({
                type: 'POST',
                url: '@ApiAddress' + 'Role/CreateRole',
                dataType: 'json',
                contentType: 'application/json',
                processData: false,
                data: JSON.stringify(model),
                headers: {
                    Authorization: 'Bearer ' + '@User.FindFirstValue("Token")'
                },
                success: function (xhr) {
                    SwalHelper.handleResponse(xhr, "ثبت نقش با موفقیت انجام شد!", function () {
                        $('#addRoleModal').modal('hide');
                        $('#RoleName').val("");
                        $('#RoleFaName').val("");
                        window.location.reload();
                    });
                },
                error: function (xhr) {
                    var msg = (xhr.responseJSON && xhr.responseJSON.message) || "خطا در ثبت نقش";
                    SwalHelper.error(msg);
                }
            });
        });
    </script>
}