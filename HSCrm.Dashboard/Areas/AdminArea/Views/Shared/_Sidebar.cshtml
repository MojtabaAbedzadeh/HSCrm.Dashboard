@using HSCrm.Dashboard.Models
@using HSCrm.Dashboard.Services
@using HSCrm.Dashboard.Services.Interface
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@inject IAuthorizationService AuthorizationService
@inject ISidebarMenuProvider SidebarProvider

@{
    var menus = SidebarProvider.GetMenus(User);
    var selected = ViewData["selected"]?.ToString() ?? "";
    var sbApiAddr = ViewBag.ApiAddress as string ?? "";
    var sbToken = User.FindFirst("Token")?.Value ?? ViewBag.Token?.ToString() ?? "";
    var sbTenantId = User.FindFirst("TenantId")?.Value ?? ViewBag.TenantId?.ToString() ?? "0";
    var defaultLogo = Url.Content("~/assets/img/logo/ec-site-logo.png");
}

@functions {
    public static async Task<bool> IsMenuVisibleAsync(
        SidebarMenuItem menu,
        ClaimsPrincipal user,
        IAuthorizationService authorizationService)
    {
        if (!string.IsNullOrWhiteSpace(menu.AllowedRoles))
        {
            var allowedRoles = menu.AllowedRoles
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (!allowedRoles.Any(user.IsInRole))
                return false;
        }

        if (!string.IsNullOrEmpty(menu.PermissionKey))
        {
            var requiredPerms = menu.PermissionKey
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            var anyGranted = false;
            foreach (var perm in requiredPerms)
            {
                var result = await authorizationService.AuthorizeAsync(
                    user,
                    null,
                    $"Permission:{perm}"
                );
                if (result.Succeeded)
                {
                    anyGranted = true;
                    break;
                }
            }

            if (!anyGranted)
                return false;
        }

        if (menu.Children != null && menu.Children.Count > 0)
        {
            foreach (var child in menu.Children)
            {
                if (await IsMenuVisibleAsync(child, user, authorizationService))
                    return true;
            }

            return false;
        }

        return true;
    }
}

<div class="ec-left-sidebar ec-bg-sidebar">
    <div id="sidebar" class="sidebar ec-sidebar-footer">

        <!-- Logo & Company Title -->
        @{
            var homeUrl = (User.IsInRole("Owner") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.HasClaim("Permission", HSCrm.Dashboard.Costants.Permissions.AccountingReports.View))
                ? "/AdminArea/Home/Index"
                : "/AdminArea/Employee/Index";
        }
        <div class="ec-brand">
            <a id="sidebarBrandLink" href="@homeUrl" title="پنل مدیریت">
                <img id="sidebarBrandLogo" class="ec-brand-icon" src="@defaultLogo" alt="لوگو" onerror="this.onerror=null;this.src='@defaultLogo';" />
                <span id="sidebarBrandName" class="ec-brand-name">سامانه مدیریت</span>
            </a>
        </div>
        <div class="ec-navigation" data-simplebar>
            <ul class="nav sidebar-inner" id="sidebar-menu">
                @{
                    string lastCategory = null;
                }
                @foreach (var menu in menus)
                {
                    var menuVisible = await IsMenuVisibleAsync(menu, User, AuthorizationService);
                    if (!menuVisible)
                        continue;

                    List<SidebarMenuItem> visibleChildren = null;
                    if (menu.Children != null && menu.Children.Count > 0)
                    {
                        visibleChildren = new List<SidebarMenuItem>();
                        foreach (var child in menu.Children)
                        {
                            if (await IsMenuVisibleAsync(child, User, AuthorizationService))
                            {
                                visibleChildren.Add(child);
                            }
                        }
                        if (visibleChildren.Count == 0)
                            continue;
                    }

                    if (!string.IsNullOrWhiteSpace(menu.Category) && !string.Equals(lastCategory, menu.Category, StringComparison.Ordinal))
                    {
                        lastCategory = menu.Category;
                        <li class="sidebar-category-title">
                            <span>@menu.Category</span>
                        </li>
                    }

                    if (visibleChildren == null)
                    {
                        <li class="@(selected == menu.Key ? "active" : "")">
                            <a class="sidenav-item-link" href="@menu.Url">
                                <i class="@menu.Icon"></i>
                                <span class="nav-text">@menu.Title</span>
                            </a>
                        </li>
                    }
                    else
                    {
                        var isExpanded = selected.StartsWith(menu.Key) || visibleChildren.Any(c => c.Key == selected);

                        <li class="has-sub @(isExpanded ? "active expand" : "")">
                            <a class="sidenav-item-link" href="javascript:void(0)">
                                <i class="@menu.Icon"></i>
                                <span class="nav-text">@menu.Title</span>
                                <b class="caret"></b>
                            </a>

                            <div class="collapse @(isExpanded ? "show" : "")"
                                 style="display:@(isExpanded ? "block" : "none")">
                                <ul class="sub-menu">
                                    @foreach (var child in visibleChildren)
                                    {
                                        <li class="@(selected == child.Key ? "active" : "")">
                                            <a class="sidenav-item-link" href="@child.Url">
                                                <span class="nav-text">@child.Title</span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
</div>

<script>
    (function () {
        const sbApiBase = '@sbApiAddr'.replace(/\/+$/, '');
        const sbToken = '@sbToken';
        const sbTenantId = '@sbTenantId';
        const fallbackLogo = '@defaultLogo';
        const cacheKey = 'hscrm_tenant_branding_' + sbTenantId;

        function resolveLogoSrc(logoUrl) {
            if (!logoUrl) return fallbackLogo;
            if (logoUrl.startsWith('http://') || logoUrl.startsWith('https://') || logoUrl.startsWith('data:')) return logoUrl;
            const origin = sbApiBase.replace(/\/api\/?$/i, '');
            return origin + (logoUrl.startsWith('/') ? logoUrl : '/' + logoUrl);
        }

        window.applySidebarBranding = function (b) {
            if (!b) return;
            const nameEl = document.getElementById('sidebarBrandName');
            const logoEl = document.getElementById('sidebarBrandLogo');
            const linkEl = document.getElementById('sidebarBrandLink');
            if (nameEl && b.tenantTitle) {
                nameEl.textContent = b.tenantTitle;
            }
            if (linkEl && b.tenantTitle) {
                linkEl.title = b.tenantTitle;
            }
            if (logoEl) {
                logoEl.src = resolveLogoSrc(b.logoUrl);
            }
            window.__hscrmBranding = b;
        };

        try {
            const cachedRaw = sessionStorage.getItem(cacheKey);
            if (cachedRaw) {
                window.applySidebarBranding(JSON.parse(cachedRaw));
            }
        } catch (e) { }

        if (!sbApiBase || !sbToken) return;
        fetch(sbApiBase + '/Tenant/GetBranding', {
            headers: { 'Authorization': 'Bearer ' + sbToken },
            suppressGlobalAlert: true
        })
        .then(r => r.ok ? r.json() : null)
        .then(res => {
            const d = res && res.data;
            if (!d) return;
            try { sessionStorage.setItem(cacheKey, JSON.stringify(d)); } catch (e) { }
            window.applySidebarBranding(d);
        })
        .catch(() => {});
    })();
</script>
