@using System.Security.Claims
@using HSCrm.Dashboard.Costants
@using HSCrm.Dashboard.Extensions
@{
    var canViewFiscalYears = User.IsInRole("Owner")
        || User.IsInRole("Admin")
        || User.IsInRole("SuperAdmin")
        || User.HasPermission(Permissions.FiscalYears.View);
    var isManagerRole = User.IsInRole("Owner")
        || User.IsInRole("Admin")
        || User.IsInRole("SuperAdmin");
    var canViewChequeAlerts = isManagerRole || User.HasPermission(Permissions.Cheques.View);
    var canViewAgingAlerts = isManagerRole || User.HasPermission(Permissions.AccountingReports.View);
    var userImageUrl = User.FindFirst("UserImageUrl")?.Value;
    var firstName = User.FindFirst("UserFirstName")?.Value;
    var lastName = User.FindFirst("UserLastName")?.Value;
    var email = User.FindFirst(ClaimTypes.Email)?.Value;
    var mobile = User.FindFirst(ClaimTypes.MobilePhone)?.Value;
    var tenantId = User.FindFirst("TenantId")?.Value ?? ViewBag.TenantId;
    var token = User.FindFirst("Token")?.Value ?? ViewBag.Token;
    var activeFyId = User.FindFirst("FiscalYearId")?.Value ?? Context.Request.Cookies["ActiveFiscalYearId"] ?? "0";
    var activeFyStatus = User.FindFirst("FiscalYearStatus")?.Value ?? "0";
    var activeFyTitle = User.FindFirst("FiscalYearTitle")?.Value ?? "سال مالی فعال";
    var apiAddr = ViewBag.ApiAddress as string ?? "";

    var fullName = $"{firstName} {lastName}".Trim();
    if (string.IsNullOrWhiteSpace(fullName))
    {
        fullName = User.Identity?.Name ?? "کاربر سیستم";
    }

    var avatarSrc = string.IsNullOrWhiteSpace(userImageUrl)
        ? Url.Content("~/assets/img/user/img-user.jpg")
        : (userImageUrl.StartsWith("http") ? userImageUrl : $"https://localhost:7001{userImageUrl}");
}

<header class="ec-main-header" id="header">
    <nav class="navbar navbar-static-top navbar-expand-lg">
        <button id="sidebar-toggler" class="sidebar-toggle"></button>

        <div class="search-form d-lg-inline-block">
            <div class="input-group">
                <input name="query" id="search-input" class="form-control" placeholder="جستجو در منوها و صفحات..." autocomplete="off">
                <button type="button" name="search" id="search-btn" class="btn btn-flat">
                    <i class="mdi mdi-magnify"></i>
                </button>
            </div>
            <div id="search-results-container">
                <ul id="search-results"></ul>
            </div>
        </div>

        <div class="navbar-right d-flex align-items-center gap-2">
            <!-- انتخابگر سریع سال مالی فعال -->
            <div class="dropdown d-inline-block me-2">
                <button class="btn btn-sm @(activeFyStatus == "0" ? "btn-outline-success" : "btn-outline-danger") dropdown-toggle d-flex align-items-center gap-1"
                        type="button" id="hdrFiscalYearBtn" data-bs-toggle="dropdown" aria-expanded="false"
                        title="تغییر سریع سال مالی فعال بدون خروج از حساب">
                    <i class="mdi mdi-calendar-clock"></i>
                    <span id="hdrFiscalYearTitle">@activeFyTitle</span>
                    <span class="badge @(activeFyStatus == "0" ? "bg-success" : "bg-danger") ms-1" id="hdrFiscalYearBadge">
                        @(activeFyStatus == "0" ? "باز" : "بسته")
                    </span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm p-2" style="min-width: 260px;" id="hdrFiscalYearList">
                    <li class="dropdown-header fw-bold text-dark border-bottom pb-1 mb-1">
                        <i class="mdi mdi-calendar-check me-1"></i>انتخاب سال مالی فعال
                    </li>
                    <li class="text-center py-2 text-muted small" id="hdrFyLoading">در حال بارگذاری سال‌های مالی...</li>
                </ul>
            </div>

            <!-- مرکز اعلان‌های درون‌برنامه‌ای (فاز ۵) -->
            <div class="dropdown notifications-menu d-inline-block me-2" id="hdrNotifDropdown">
                <button id="hdrNotifToggle" class="dropdown-toggle nav-link ec-drop position-relative btn btn-link text-dark p-1" data-bs-toggle="dropdown" aria-expanded="false" title="مرکز اعلان‌ها">
                    <i class="mdi mdi-bell-ring-outline fs-4"></i>
                    <span id="hdrAlertBadge" class="badge bg-danger rounded-pill position-absolute top-0 start-0 d-none" style="font-size: 10px;">0</span>
                </button>
                <div class="dropdown-menu dropdown-menu-end shadow p-0" style="width: 360px; max-height: 440px; overflow-y: auto;">
                    <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                        <strong class="text-dark small"><i class="mdi mdi-bell-alert-outline me-1 text-warning"></i>مرکز اعلان‌ها</strong>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small" onclick="markAllHeaderNotificationsRead()">خواندن همه</button>
                            @if (canViewChequeAlerts)
                            {
                                <a href="/AdminArea/Cheque/Index" class="text-primary small">چک‌ها</a>
                            }
                        </div>
                    </div>
                    <div id="hdrAlertContainer" class="list-group list-group-flush small">
                        <div class="p-3 text-center text-muted">در حال دریافت اعلان‌ها...</div>
                    </div>
                </div>
            </div>

            <ul class="nav navbar-nav">
                <li class="dropdown user-menu">
                    <button class="dropdown-toggle nav-link ec-drop" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="@avatarSrc" class="user-image" alt="User Image">
                    </button>
                    <ul class="dropdown-menu dropdown-menu-right ec-dropdown-menu">
                        <li class="dropdown-header align-items-center">
                            <div class="d-flex align-items-center">
                                <img src="@avatarSrc" class="img-circle" alt="User Image" style="width: 40px; height: 40px;">
                                <div class="d-flex flex-column ms-2">
                                    <strong>@fullName</strong>
                                    <small class="text-muted">شناسه مجموعه: #@tenantId</small>
                                </div>
                            </div>
                            <small class="pt-1"><a>@email</a></small>
                        </li>
                        <li>
                            <a href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#hdrUserProfileModal">
                                <i class="mdi mdi-account"></i>پروفایل و نشست کاربری
                            </a>
                        </li>
                        <li>
                            <a href="/AdminArea/Employee/Index">
                                <i class="mdi mdi-account-clock-outline"></i>کارتابل کارمند و کارکرد من
                            </a>
                        </li>
                        @if (User.HasPermission(Permissions.FiscalYears.View))
                        {
                            <li>
                                <a href="/AdminArea/FiscalYear/Index">
                                    <i class="mdi mdi-calendar-Lock"></i>مدیریت و بستن سال مالی
                                </a>
                            </li>
                        }
                        @if (canViewAgingAlerts)
                        {
                            <li>
                                <a href="/AdminArea/Accounting/Reports">
                                    <i class="mdi mdi-finance"></i>تراز آزمایشی و سود و زیان
                                </a>
                            </li>
                        }
                        <li class="dropdown-footer">
                            <a href="/Account/Logout"><i class="mdi mdi-logout"></i> خروج از سیستم</a>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </nav>
</header>

<!-- مودال اطلاعات پروفایل کاربر -->
<div class="modal fade" id="hdrUserProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="mdi mdi-account-circle me-1"></i>اطلاعات پروفایل و نشست فعال</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                    <img src="@avatarSrc" class="rounded-circle border" style="width: 64px; height: 64px; object-fit: cover;" />
                    <div>
                        <h6 class="fw-bold mb-1">@fullName</h6>
                        <div class="text-muted small">@email</div>
                        <div class="text-muted small">@mobile</div>
                    </div>
                </div>
                <div class="row g-2 small">
                    <div class="col-6">
                        <div class="p-2 bg-light rounded border">
                            <div class="text-muted">شناسه تننت (TenantId):</div>
                            <strong class="font-monospace">@tenantId</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 bg-light rounded border">
                            <div class="text-muted">وضعیت سال مالی فعال:</div>
                            <strong class="@(activeFyStatus == "0" ? "text-success" : "text-danger")">
                                @(activeFyStatus == "0" ? "باز (مجاز به ثبت سند)" : "بسته (فقط مشاهده گزارشات)")
                            </strong>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        const hdrApiBase = '@apiAddr'.replace(/\/+$/, '');
        const hdrToken = '@token';
        const hdrTenantId = '@tenantId';
        const currentFyId = '@activeFyId';

        // تزریق خودکار هدر X-FiscalYear-Id و Authorization در تمام درخواست‌های jQuery AJAX
        document.addEventListener('DOMContentLoaded', function () {
            if (window.jQuery && currentFyId && currentFyId !== '0') {
                $.ajaxSetup({
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('X-FiscalYear-Id', currentFyId);
                    }
                });
            }
            if (!hdrApiBase || !hdrToken) return;

            const headers = {
                'Authorization': 'Bearer ' + hdrToken,
                'X-FiscalYear-Id': currentFyId
            };

            @if (canViewFiscalYears)
            {
            <text>
            // ۱. بارگذاری لیست سال‌های مالی جهت سوییچ سریع در هدر (فقط برای کاربران دارای مجوز)
            fetch(`${hdrApiBase}/FiscalYear/GetAll?tenantId=${hdrTenantId}`, { headers, suppressGlobalAlert: true })
                .then(r => r.ok ? r.json() : ({ data: [] }))
                .then(res => {
                    const list = res.data || res || [];
                    const ul = document.getElementById('hdrFiscalYearList');
                    if (!ul) return;
                    let html = `<li class="dropdown-header fw-bold text-dark border-bottom pb-1 mb-1">
                                    <i class="mdi mdi-calendar-check me-1"></i>انتخاب سال مالی فعال
                                </li>`;
                    if (!Array.isArray(list) || list.length === 0) {
                        html += `<li><a class="dropdown-item small text-muted" href="/AdminArea/FiscalYear/Index">مدیریت سال‌های مالی</a></li>`;
                    } else {
                        list.forEach(fy => {
                            const isClosed = fy.isClosed === true || fy.status === 2 || fy.status === 1;
                            const isCurrent = String(fy.id) === String(currentFyId);
                            const title = fy.title || fy.name || ('سال مالی #' + fy.id);
                            if (isCurrent) {
                                const lbl = document.getElementById('hdrFiscalYearTitle');
                                if (lbl) lbl.textContent = title;
                            }
                            html += `<li>
                                <a class="dropdown-item d-flex justify-content-between align-items-center py-2 ${isCurrent ? 'bg-light fw-bold text-primary' : ''}"
                                   href="javascript:void(0)"
                                   onclick="window.switchActiveFiscalYear(${fy.id}, ${isClosed ? 2 : 0}, '${title.replace(/'/g, "")}')">
                                    <span>${isCurrent ? '✓ ' : ''}${title}</span>
                                    <span class="badge ${isClosed ? 'bg-danger' : 'bg-success'}">${isClosed ? 'بسته' : 'باز'}</span>
                                </a>
                            </li>`;
                        });
                        html += `<li><hr class="dropdown-divider my-1"></li>
                                 <li><a class="dropdown-item small text-primary text-center" href="/AdminArea/FiscalYear/Index">
                                    <i class="mdi mdi-cog-outline me-1"></i>عملیات پایان سال مالی و سند اختتامیه
                                 </a></li>`;
                    }
                    ul.innerHTML = html;
                })
                .catch(() => {});
            </text>
            }
            else
            {
            <text>
            // ۱. نمایش عنوان سال مالی فعال از اندپوینت عمومی Dropdown برای کاربران بدون مجوز مدیریت سال مالی
            fetch(`${hdrApiBase}/FiscalYear/FiscalYearDropdownList?tenantId=${hdrTenantId}`, { headers, suppressGlobalAlert: true })
                .then(r => r.ok ? r.json() : ({ data: [] }))
                .then(res => {
                    const list = res.data || [];
                    if (Array.isArray(list)) {
                        const cur = list.find(fy => String(fy.drId ?? fy.id) === String(currentFyId));
                        if (cur) {
                            const lbl = document.getElementById('hdrFiscalYearTitle');
                            if (lbl) lbl.textContent = cur.drName || cur.title || 'سال مالی فعال';
                        }
                    }
                    const ul = document.getElementById('hdrFiscalYearList');
                    if (ul) {
                        ul.innerHTML = `<li class="dropdown-header fw-bold text-dark border-bottom pb-1 mb-1">
                                            <i class="mdi mdi-calendar-check me-1"></i>سال مالی فعال نشست
                                        </li>
                                        <li class="px-3 py-2 small text-muted">تغییر سال مالی از طریق خروج و انتخاب در صفحه ورود یا توسط مدیر امکان‌پذیر است.</li>`;
                    }
                })
                .catch(() => {});
            </text>
            }

            // ۲. بارگذاری مرکز اعلان‌ها (با صفر شدن خودکار شمارنده پس از باز شدن منو)
            const hdrUserId = '@(User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "")';
            const seenDynKey = `hscrm_seen_dyn_${hdrTenantId}_${hdrUserId}`;
            let lastHdrItems = [];

            function getSeenDynSet() {
                try {
                    const raw = localStorage.getItem(seenDynKey);
                    const arr = raw ? JSON.parse(raw) : [];
                    return new Set(Array.isArray(arr) ? arr : []);
                } catch { return new Set(); }
            }

            function saveSeenDynSet(set) {
                try {
                    localStorage.setItem(seenDynKey, JSON.stringify(Array.from(set).slice(-100)));
                } catch { }
            }

            function dynKey(n) {
                return `${n.category || 'Sys'}_${n.referenceId ?? ''}_${n.createdAtShamsi || ''}`;
            }

            function setHdrBadgeCount(count) {
                const badge = document.getElementById('hdrAlertBadge');
                if (!badge) return;
                if (count > 0) {
                    badge.textContent = count;
                    badge.classList.remove('d-none');
                } else {
                    badge.textContent = '0';
                    badge.classList.add('d-none');
                }
            }

            function escNotif(v) {
                return String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }

            function renderHdrNotifications(items) {
                const container = document.getElementById('hdrAlertContainer');
                if (!container) return;

                if (!items || items.length === 0) {
                    container.innerHTML = `<div class="p-3 text-center text-success">
                        <i class="mdi mdi-check-circle-outline fs-4 d-block mb-1"></i>
                        اعلان جدیدی برای نمایش وجود ندارد.
                    </div>`;
                    return;
                }

                const seenSet = getSeenDynSet();
                container.innerHTML = items.map(n => {
                    const isDyn = n.isDynamicAlert || !n.id;
                    const effectiveRead = isDyn ? seenSet.has(dynKey(n)) : !!n.isRead;
                    const sevClass = n.severity === 'danger' ? 'text-danger' : n.severity === 'warning' ? 'text-warning' : n.severity === 'success' ? 'text-success' : 'text-primary';
                    const catLabel = n.category === 'WorkLog' ? 'ساعت کار' : n.category === 'Cheque' ? 'چک' : n.category === 'Project' ? 'پروژه' : 'سیستم';
                    return `<a href="javascript:void(0)" onclick="clickHeaderNotification(${n.id ?? 'null'}, '${escNotif(n.actionUrl || '')}', '${escNotif(dynKey(n))}')"
                               class="list-group-item list-group-item-action py-2 ${effectiveRead ? 'opacity-75' : 'bg-light'}">
                        <div class="d-flex justify-content-between align-items-start gap-1">
                            <strong class="${sevClass}">${escNotif(n.title)}</strong>
                            <span class="badge bg-secondary">${catLabel}</span>
                        </div>
                        <div class="text-muted mt-1">${escNotif(n.message)}</div>
                        <div class="d-flex justify-content-between align-items-center mt-1" style="font-size: 10px;">
                            <span class="text-muted font-monospace" dir="ltr">${escNotif(n.createdAtShamsi || '')}</span>
                            ${!effectiveRead ? '<span class="text-primary fw-bold">جدید</span>' : ''}
                        </div>
                    </a>`;
                }).join('');
            }

            window.loadHeaderNotifications = function () {
                fetch(`${hdrApiBase}/Notification/GetMyNotifications?limit=25`, { headers, suppressGlobalAlert: true })
                    .then(r => r.ok ? r.json() : null)
                    .then(res => {
                        const feed = res?.data;
                        lastHdrItems = feed?.items || [];
                        const seenSet = getSeenDynSet();

                        let persistentUnread = 0;
                        let unseenDyn = 0;
                        lastHdrItems.forEach(n => {
                            const isDyn = n.isDynamicAlert || !n.id;
                            if (isDyn) {
                                if (!seenSet.has(dynKey(n))) unseenDyn++;
                            } else if (!n.isRead) {
                                persistentUnread++;
                            }
                        });

                        const serverUnread = Number(feed?.unreadCount || 0);
                        const dynTotal = lastHdrItems.filter(n => n.isDynamicAlert || !n.id).length;
                        const persistentServerUnread = Math.max(0, serverUnread - dynTotal);
                        const effectiveUnread = Math.max(persistentUnread, persistentServerUnread) + unseenDyn;

                        setHdrBadgeCount(effectiveUnread);
                        renderHdrNotifications(lastHdrItems);
                    })
                    .catch(() => {});
            };

            function acknowledgeVisibleNotifications(refreshAfter) {
                setHdrBadgeCount(0);
                const seenSet = getSeenDynSet();
                let hasPersistentUnread = false;
                lastHdrItems.forEach(n => {
                    const isDyn = n.isDynamicAlert || !n.id;
                    if (isDyn) {
                        seenSet.add(dynKey(n));
                    } else if (!n.isRead) {
                        hasPersistentUnread = true;
                    }
                });
                saveSeenDynSet(seenSet);

                if (hasPersistentUnread) {
                    fetch(`${hdrApiBase}/Notification/MarkAllAsRead`, {
                        method: 'POST',
                        headers,
                        suppressGlobalAlert: true
                    }).then(() => {
                        lastHdrItems.forEach(n => { if (n.id) n.isRead = true; });
                        if (refreshAfter) renderHdrNotifications(lastHdrItems);
                    }).catch(() => {});
                } else if (refreshAfter) {
                    renderHdrNotifications(lastHdrItems);
                }
            }

            const notifDropdown = document.getElementById('hdrNotifDropdown');
            if (notifDropdown) {
                notifDropdown.addEventListener('shown.bs.dropdown', function () {
                    acknowledgeVisibleNotifications(false);
                });
            }

            window.clickHeaderNotification = function (id, url, dKey) {
                if (dKey) {
                    const seenSet = getSeenDynSet();
                    seenSet.add(dKey);
                    saveSeenDynSet(seenSet);
                }
                if (id) {
                    fetch(`${hdrApiBase}/Notification/MarkAsRead/${id}`, {
                        method: 'POST',
                        headers,
                        suppressGlobalAlert: true
                    }).finally(() => {
                        if (url) window.location.href = url;
                        else window.loadHeaderNotifications();
                    });
                } else if (url) {
                    window.location.href = url;
                } else {
                    acknowledgeVisibleNotifications(true);
                }
            };

            window.markAllHeaderNotificationsRead = function () {
                acknowledgeVisibleNotifications(true);
                fetch(`${hdrApiBase}/Notification/MarkAllAsRead`, {
                    method: 'POST',
                    headers,
                    suppressGlobalAlert: true
                }).then(() => window.loadHeaderNotifications()).catch(() => {});
            };

            window.loadHeaderNotifications();
        });

        window.switchActiveFiscalYear = function (fyId, fyStatus, fyTitle) {
            const formData = new URLSearchParams();
            formData.append('fiscalYearId', fyId);
            formData.append('fiscalYearStatus', fyStatus);
            formData.append('fiscalYearTitle', fyTitle);

            fetch('/Account/SwitchFiscalYear', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData.toString()
            })
            .then(r => r.json())
            .then(res => {
                if (res && res.status) {
                    window.location.reload();
                }
            });
        };
    })();
</script>
