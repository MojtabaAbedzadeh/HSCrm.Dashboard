@using System.Security.Claims
@using HSCrm.Dashboard.Costants
@model IEnumerable<CustomerModel>

@{
    ViewData["AdminTitle"] = "مشتری ها";
    ViewData["selected"] = "customer_list";

    string ApiAddress = ViewBag.ApiAddress;
    string UserId = ViewBag.UserId;
}

@section styles {
    <link href="~/assets/plugins/data-tables/datatables.bootstrap5.min.css" rel="stylesheet">
    <link href="~/assets/plugins/data-tables/responsive.datatables.min.css" rel="stylesheet">
    <link href="~/assets/css/ekka.css" id="ekka-css" rel="stylesheet">
    <link href="~/lib/persiandate/persian-datepicker.css" rel="stylesheet" />
}

<div class="breadcrumb-wrapper breadcrumb-contacts">
    <div>
        <h1>لیست مشتریان</h1>
        <p class="breadcrumbs"><span><a href="/AdminArea/Home/Index">خانه</a></span> <span><i class="mdi mdi-chevron-left"></i></span>مشتری</p>
    </div>
    <div>
        @if (User.HasPermission(Permissions.Customers.Create))
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCustomer"> اضافه کردن مشتری </button>
        }
    </div>
</div>
<div class="row">
    <div class="col-12">
        <div class="ec-vendor-list card card-default">
            <div class="card-body">
                <div class="table-responsive-md">
                    <div id="responsive-data-table_wrapper" class="dataTables_wrapper dt-bootstrap5 no-footer">
                        <table id="responsive-data-table" class="table dataTable no-footer" aria-describedby="responsive-data-table_info">
                            <thead>
                                <tr>
                                    <th>نام و نام خانوادگی</th>
                                    <th>شماره همراه</th>
                                    <th>ایمیل</th>
                                    <th>آدرس</th>
                                    <th class="text-end">مانده بدهی (ریال)</th>
                                    <th class="text-end">چک در جریان (ریال)</th>
                                    <th>حساب پرتال</th>
                                    <th>فعالیت</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Name</td>
                                        <td>@item.Phone</td>
                                        <td>@item.Email</td>
                                        <td>@item.Address</td>
                                        <td class="text-end font-monospace cust-bal-cell" data-cust-id="@item.Id" dir="ltr"><span class="text-muted small">...</span></td>
                                        <td class="text-end font-monospace cust-chq-cell" data-cust-id="@item.Id" dir="ltr"><span class="text-muted small">...</span></td>
                                        <td class="cust-portal-cell" data-cust-id="@item.Id"><span class="text-muted small">...</span></td>
                                        <td>
                                            <div class="btn-group mb-1">
                                                <a class="btn btn-outline-primary btn-sm" href="/AdminArea/Accounting/AgingAndStatements?partyType=1&partyId=@item.Id" title="صورت‌حساب ۳۶۰، فاکتورها و چک‌ها">۳۶۰</a>
                                                @if (User.HasPermission(Permissions.Customers.Edit))
                                                {
                                                    <button type="button"
                                                            class="btn btn-outline-warning btn-sm"
                                                            title="ریست رمز عبور پرتال"
                                                            onclick="openCustomerResetPasswordModal(@item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Name ?? ""))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Email ?? ""))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Phone ?? ""))')">
                                                        <i class="mdi mdi-lock-reset"></i>
                                                    </button>
                                                }
                                                <a class="btn btn-outline-success" href="@("customerprofile?customerId=" + item.Id)">پروفایل</a>
                                                <button type="button" class="btn btn-outline-success dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-display="static">
                                                    <span class="sr-only">پروفایل</span>
                                                </button>
                                                <div class="dropdown-menu">
                                                    <a class="dropdown-item text-primary fw-bold" href="/AdminArea/Accounting/AgingAndStatements?partyType=1&partyId=@item.Id">صورت‌حساب جامع ۳۶۰ درجه</a>
                                                    @if (User.HasPermission(Permissions.Customers.Edit))
                                                    {
                                                        <a class="dropdown-item" href="#" onclick="showUpdateModal(@item.Id)">ویرایش</a>
                                                        <a class="dropdown-item text-info" href="javascript:void(0)" onclick="openPortalAccountModal(@item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Name ?? ""))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Email ?? ""))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Phone ?? ""))')">مدیریت حساب پرتال مشتری</a>
                                                        <a class="dropdown-item text-warning fw-bold" href="javascript:void(0)" onclick="openCustomerResetPasswordModal(@item.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Name ?? ""))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Email ?? ""))', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Phone ?? ""))')">ریست رمز عبور پرتال</a>
                                                    }
                                                    @if (User.HasPermission(Permissions.Customers.Delete))
                                                    {
                                                        <a class="dropdown-item" href="#">حذف</a>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-add-customer" id="addCustomer" tabindex="-1" role="dialog" aria-labelledby="addCustomerModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <form id="frmCustomer">
                <div class="modal-header px-4">
                    <h5 class="modal-title" id="addCustomerModalTitle">تعریف مشتری جدید</h5>
                </div>
                <div class="modal-body px-4">
                    <div class="row mb-2">
                        <div class="col-lg-3" style="margin-top:10px">
                            <div class="ec-vendor-img-upload" style="margin-bottom:-10px; position:sticky;top:30px;">
                                <div class="ec-vendor-main-img">
                                    <div class="avatar-upload"
                                         style="margin-bottom: 10px; position:relative;">
                                        <div class="avatar-edit"
                                             style="position:absolute; left:25px; z-index:1; top:25px">
                                            <input type="file" id="UserImagesC" name="UserImagesC" class="ec-image-upload" accept=".png, .jpg, .jpeg" style="opacity:0; width:40px;height:40px;padding:0;border-radius:50%; position:absolute;z-index:1">
                                            <input id="UserImageUrlC" name="UserImageUrlC" hidden />
                                            <label for="UserImagesC"
                                                   style="display:flex; -webkit-box-align:center; align-items:center; -webkit-box-pack:center;justify-content:center;width:40px; height:40px;padding:10px;margin-bottom:auto;border-radius:10px;background:#ffffff;border: 1px solid #eeeeee;box-shadow: 0px 0px 8px 0px rgba(0, 0, 0, 0.15); cursor: pointer; font-weight: normal; transition: all 0.2s ease-in-out;">
                                                <img src="~/assets/img/icons/edit.svg" class="svg_img header_svg" alt="edit"
                                                     style="width:25px;opacity:0.6;">
                                            </label>
                                        </div>
                                        <div class="avatar-preview ec-preview"
                                             style="width:100%;height:100%;padding:15px;position:relative;border:1px solid #eeeeee;border-radius:15px;">
                                            <div class="imagePreview ec-div-preview"
                                                 style="width:100%;height:100%;display:flex;background-size: cover;background-repeat: no-repeat;background-position: center;">
                                                <img id="imgUserC" name="imgUserC" class="ec-image-preview" src="~/assets/img/user/default-user.png" alt="User"
                                                     style="margin:auto;vertical-align:middle;max-width:100%;border-radius:10px">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-9">
                            <div class="ec-vendor-upload-detail">
                                <div class="row mb-2">
                                    <div class="col-lg-6">
                                        <div class="form-group form-floating">
                                            <input class="form-control text-end" id="UserFirstName" name="UserFirstName" placeholder="نام">
                                            <label for="UserFirstName" style="right:0!important; left:unset!important;">نام</label>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="form-group form-floating">
                                            <input class="form-control text-end" id="UserLastName" name="UserLastName" placeholder="نام خانوادگی">
                                            <label for="UserLastName" style="right:0!important; left:unset!important;">نام خانوادگی</label>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="form-group form-floating">
                                            <input class="form-control text-end" id="UserName" name="UserName" placeholder="نام کاربری">
                                            <label for="UserName" style="right:0!important; left:unset!important;">نام کاربری</label>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="form-group form-floating">
                                            <input type="password" class="form-control text-end" id="Password" name="Password" placeholder="رمز عبور">
                                            <label for="Password" style="right:0!important; left:unset!important;">رمز عبور</label>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="form-group form-floating">
                                            <input class="form-control text-end" id="Email" name="Email" placeholder="ایمیل">
                                            <label for="Email" style="right:0!important; left:unset!important;">ایمیل</label>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="form-group form-floating">
                                            <input class="form-control text-end" id="Phone" name="Phone" placeholder="شماره همراه">
                                            <label for="Phone" style="right:0!important; left:unset!important;">شماره همراه</label>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label class="form-label d-block mb-2">جنسیت</label>
                                            <div class="form-check form-check-inline">
                                                <input checked class="form-check-input" type="radio" name="UserGender" id="CustomerGenderMale" value="true">
                                                <label class="form-check-label" for="CustomerGenderMale">مرد</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="UserGender" id="CustomerGenderFemale" value="false">
                                                <label class="form-check-label" for="CustomerGenderFemale">زن</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group form-floating">
                                            <input class="form-control text-end" id="Address" name="Address" placeholder="آدرس">
                                            <label for="Address" style="right:0!important; left:unset!important;">آدرس</label>
                                        </div>
                                    </div>
                                    <div class="col-lg-12 alert" style="color:red">
                                        <span class="text-danger" id="spnValidateC"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer px-4">
                    <button type="button" class="btn btn-secondary btn-pill" data-bs-dismiss="modal">
                        لغو
                    </button>
                    <button id="btnCustomerSubmit" type="button" class="btn btn-primary btn-pill">ذخیره </button>
                    <div id="divMessageC" class="text-center hidden position-absolute" style="left:50px;"></div>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade modal-add-contact" id="editCustomer" tabindex="-1" role="dialog"
     aria-labelledby="customerModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <form id="frmEditCustomer">
                <div class="modal-header px-4">
                    <h5 class="modal-title" id="customerModalCenterTitle">ویرایش اطلاعات مشتری</h5>
                </div>
                <div class="modal-body px-4">
                    <div class="row mb-2">
                        <div class="col-lg-4">
                            <div class="form-group form-floating">
                                <input id="customerId" name="customerId" hidden>
                                <input id="TenantIdU" name="TenantId" value="@ViewBag.TenantId" hidden>
                                <input id="ModifiedByIdU" name="ModifiedById" value="@UserId" hidden>
                                <input class="form-control text-end" id="NameU" name="NameU" placeholder=" نام و نام خانوادگی">
                                <label for="NameU" style="right:0!important; left:unset!important;">نام و نام خانوادگی</label>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="form-group form-floating">
                                <input class="form-control text-end" id="PhoneU" name="PhoneU" placeholder=" شماره تماس">
                                <label for="PhoneU" style="right:0!important; left:unset!important;">شماره تماس</label>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="form-group form-floating">
                                <input class="form-control text-end" id="EmailU" name="EmailU" placeholder="ایمیل">
                                <label for="EmailU" style="right:0!important; left:unset!important;">ایمیل</label>
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <div class="form-group form-floating">
                                <input class="form-control text-end" id="AddressU" name="AddressU" placeholder="آدرس">
                                <label for="AddressU" style="right:0!important; left:unset!important;">آدرس</label>
                            </div>
                        </div>
                        <div class="col-lg-12 alert" style="color:red">
                            <span class="text-danger" id="spnValidateU"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer px-4">
                    <button type="button" class="btn btn-secondary btn-pill" data-bs-dismiss="modal">
                        لغو
                    </button>
                    <button id="btnCustomerUpdate" type="button" class="btn btn-primary btn-pill">ذخیره </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- مودال فعال‌سازی / بازنشانی رمز پرتال مشتری (فاز ۴) -->
<div class="modal fade" id="customerPortalModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="mdi mdi-account-key-outline me-1 text-primary"></i>حساب پرتال مشتری: <span id="cpMdlCustName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="cpMdlCustId" value="0" />
                <input type="hidden" id="cpMdlHasAccount" value="false" />
                <div id="cpMdlActivateBox">
                    <div id="cpMdlActivateNotice" class="alert alert-warning small mb-3" style="display:none;">
                        برای این مشتری هنوز حساب پرتال فعال نشده است. با تعیین نام کاربری و رمز عبور اولیه در همین فرم، حساب پرتال ایجاد و فعال می‌شود.
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">نام کاربری ورود به پرتال *</label>
                        <input type="text" id="cpMdlUserName" class="form-control" dir="ltr" placeholder="مثلاً customer_ali" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">رمز عبور اولیه *</label>
                        <div class="input-group" dir="ltr">
                            <input type="password" id="cpMdlPassword" class="form-control" placeholder="مثلاً Abcd&#64;1234" />
                            <button type="button" class="btn btn-outline-secondary" onclick="toggleCustomerPwdField('cpMdlPassword', this)" title="نمایش/مخفی کردن"><i class="mdi mdi-eye-outline"></i></button>
                        </div>
                        <small class="text-muted d-block mt-1">رمز عبور باید حداقل ۸ کاراکتر شامل حروف بزرگ، کوچک، عدد و نماد (مانند &#64; یا #) باشد.</small>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-bold">تلفن</label>
                            <input type="text" id="cpMdlPhone" class="form-control" dir="ltr" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">ایمیل</label>
                            <input type="email" id="cpMdlEmail" class="form-control" dir="ltr" />
                        </div>
                    </div>
                </div>
                <div id="cpMdlResetBox" style="display:none;">
                    <div class="alert alert-success small">
                        این مشتری دارای حساب پرتال فعال با نام کاربری <strong id="cpMdlExistingUserName" class="font-monospace"></strong> است.
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">رمز عبور جدید جهت بازنشانی *</label>
                        <div class="input-group" dir="ltr">
                            <input type="password" id="cpMdlNewPassword" class="form-control" placeholder="مثلاً Abcd&#64;1234" />
                            <button type="button" class="btn btn-outline-secondary" onclick="toggleCustomerPwdField('cpMdlNewPassword', this)" title="نمایش/مخفی کردن"><i class="mdi mdi-eye-outline"></i></button>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold">تکرار رمز عبور جدید *</label>
                        <div class="input-group" dir="ltr">
                            <input type="password" id="cpMdlConfirmNewPassword" class="form-control" placeholder="تکرار رمز عبور جدید" />
                            <button type="button" class="btn btn-outline-secondary" onclick="toggleCustomerPwdField('cpMdlConfirmNewPassword', this)" title="نمایش/مخفی کردن"><i class="mdi mdi-eye-outline"></i></button>
                        </div>
                        <small class="text-muted d-block mt-1">رمز عبور باید حداقل ۸ کاراکتر شامل حروف بزرگ، کوچک، عدد و نماد (مانند &#64; یا #) باشد.</small>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" onclick="submitCustomerPortalModal()">ذخیره</button>
            </div>
        </div>
    </div>
</div>

@section AdminScripts {
    <script>
        $("#btnCustomerSubmit").on('click', function (e) {
            e.preventDefault();
            var firstName = ($("#UserFirstName").val() || "").trim();
            var lastName = ($("#UserLastName").val() || "").trim();
            var userName = ($("#UserName").val() || "").trim();
            var password = $("#Password").val() || "";
            if (!firstName || !lastName || !userName) {
                SwalHelper.warning("لطفاً نام، نام خانوادگی و نام کاربری مشتری را وارد نمایید.");
                return false;
            }
            if (!password || password.length < 6) {
                SwalHelper.warning("رمز عبور باید حداقل ۶ کاراکتر باشد.");
                return false;
            }
            var formData = new FormData($("#frmCustomer")[0]);
            $.ajax({
                type: 'POST',
                url: '@ApiAddress' + 'Customer/CreateCustomer',
                processData: false,
                contentType: false,
                dataType: "json",
                data: formData,
                headers: {
                    "Authorization": "Bearer " + "@User.FindFirstValue("Token")"
                },
                success: function (response) {
                    SwalHelper.handleResponse(response, "اطلاعات مشتری با موفقیت ثبت شد!", function () {
                        $('#addCustomer').modal('hide');
                        window.location.reload();
                    });
                },
                error: function (xhr) {
                    var msg = (xhr.responseJSON && xhr.responseJSON.message) || "خطا در ثبت اطلاعات مشتری";
                    SwalHelper.error(msg);
                }
            });
        });
    </script>
    <script>
        function showUpdateModal(customerId) {
            $("#customerModalCenterTitle").text("ویرایش اطلاعات");
            $.ajax({
                type: 'GET',
                url: '@ApiAddress' + 'Customer/GetById?customerId=' + customerId,
                dataType: 'json',
                headers: {
                    "Authorization": "Bearer " + "@User.FindFirstValue("Token")"
                },
                success: function (xhr) {
                    if (xhr && xhr.data) {
                        $("#customerId").val(xhr.data.id);
                        $("#NameU").val(xhr.data.name);
                        $("#PhoneU").val(xhr.data.phone);
                        $("#EmailU").val(xhr.data.email);
                        $("#AddressU").val(xhr.data.address);
                        $("#TenantIdU").val(xhr.data.tenantId);
                        $("#ModifiedByIdU").val("@UserId");
                        $("#editCustomer").modal('show');
                    } else {
                        SwalHelper.error("اطلاعات مشتری یافت نشد.");
                    }
                },
                error: function () {
                    SwalHelper.error("خطا در بازیابی اطلاعات مشتری از سرور.");
                }
            });
        }
        $("#btnCustomerUpdate").on('click', function (e) {
            e.preventDefault();
            var name = $("#NameU").val();
            if (!name || name.trim() === "") {
                SwalHelper.warning("لطفاً نام مشتری را وارد نمایید.");
                return false;
            }
            var model = {
                customerId: $("#customerId").val(),
                name: $("#NameU").val(),
                phone: $("#PhoneU").val(),
                email: $("#EmailU").val(),
                address: $("#AddressU").val(),
                modifiedById: $("#ModifiedByIdU").val(),
                tenantId: $("#TenantIdU").val(),
            };
            $.ajax({
                type: 'PUT',
                url: '@ApiAddress' + 'Customer/UpdateCustomer',
                dataType: 'json',
                headers: {
                    "Authorization": "Bearer " + "@User.FindFirstValue("Token")"
                },
                contentType: 'application/json',
                processData: false,
                data: JSON.stringify(model),
                success: function (xhr) {
                    SwalHelper.handleResponse(xhr, "ویرایش اطلاعات مشتری با موفقیت انجام شد!", function () {
                        $('#editCustomer').modal('hide');
                        window.location.reload();
                    });
                },
                error: function (xhr) {
                    var msg = (xhr.responseJSON && xhr.responseJSON.message) || "خطا در ویرایش اطلاعات مشتری";
                    SwalHelper.error(msg);
                }
            });
        });
    </script>
    <script>
        (function () {
            const apiBase = '@ApiAddress'.replace(/\/+$/, '');
            const token = '@User.FindFirstValue("Token")';
            if (!apiBase || !token) return;

            fetch(apiBase + '/Customer/GetBalances', {
                headers: { 'Authorization': 'Bearer ' + token }
            })
            .then(r => r.json())
            .then(res => {
                const list = res.data || [];
                const map = {};
                list.forEach(x => { map[x.customerId] = x; });

                document.querySelectorAll('.cust-bal-cell').forEach(cell => {
                    const id = Number(cell.getAttribute('data-cust-id'));
                    const row = map[id];
                    if (!row) { cell.innerHTML = '<span class="text-muted">0</span>'; return; }
                    const bal = Number(row.openReceivableBalance || 0);
                    if (bal > 0) {
                        cell.innerHTML = `<span class="fw-bold text-danger">${bal.toLocaleString('fa-IR')}</span>`;
                    } else if (bal < 0) {
                        cell.innerHTML = `<span class="fw-bold text-success">${Math.abs(bal).toLocaleString('fa-IR')} (بس)</span>`;
                    } else {
                        cell.innerHTML = '<span class="text-muted">0</span>';
                    }
                });

                document.querySelectorAll('.cust-chq-cell').forEach(cell => {
                    const id = Number(cell.getAttribute('data-cust-id'));
                    const row = map[id];
                    const chq = Number(row?.pendingChequesAmount || 0);
                    if (chq > 0) {
                        cell.innerHTML = `<span class="badge bg-info text-dark font-monospace">${chq.toLocaleString('fa-IR')}</span>`;
                    } else {
                        cell.innerHTML = '<span class="text-muted">0</span>';
                    }
                });
            })
            .catch(() => {
                document.querySelectorAll('.cust-bal-cell, .cust-chq-cell').forEach(c => { c.textContent = '-'; });
            });

            window.cpPortalStatusMap = {};
            fetch(apiBase + '/Customer/GetPortalStatuses', {
                headers: { 'Authorization': 'Bearer ' + token },
                suppressGlobalAlert: true
            })
            .then(r => r.ok ? r.json() : ({ data: [] }))
            .then(res => {
                const list = res.data || [];
                list.forEach(x => { window.cpPortalStatusMap[x.customerId] = x; });
                document.querySelectorAll('.cust-portal-cell').forEach(cell => {
                    const id = Number(cell.getAttribute('data-cust-id'));
                    const st = window.cpPortalStatusMap[id];
                    if (st && st.hasPortalAccount) {
                        cell.innerHTML = `<span class="badge bg-success">فعال</span> <small class="text-muted font-monospace">${st.userName || ''}</small>`;
                    } else {
                        cell.innerHTML = '<span class="badge bg-secondary">بدون حساب</span>';
                    }
                });
            }).catch(() => {});

            window.toggleCustomerPwdField = function (inputId, btn) {
                const inp = document.getElementById(inputId);
                if (!inp) return;
                const isPwd = inp.type === 'password';
                inp.type = isPwd ? 'text' : 'password';
                const ico = btn && btn.querySelector('i');
                if (ico) ico.className = isPwd ? 'mdi mdi-eye-off-outline' : 'mdi mdi-eye-outline';
            };

            window.openPortalAccountModal = function (custId, custName, email, phone, fromReset) {
                const st = (window.cpPortalStatusMap || {})[custId];
                document.getElementById('cpMdlCustId').value = custId;
                document.getElementById('cpMdlCustName').textContent = custName || '';
                const hasAcc = !!(st && st.hasPortalAccount);
                document.getElementById('cpMdlHasAccount').value = hasAcc ? 'true' : 'false';
                document.getElementById('cpMdlActivateBox').style.display = hasAcc ? 'none' : 'block';
                document.getElementById('cpMdlResetBox').style.display = hasAcc ? 'block' : 'none';
                document.getElementById('cpMdlActivateNotice').style.display = (!hasAcc && fromReset) ? 'block' : 'none';
                document.getElementById('cpMdlExistingUserName').textContent = (st && st.userName) || '';
                document.getElementById('cpMdlEmail').value = email || '';
                document.getElementById('cpMdlPhone').value = phone || '';
                document.getElementById('cpMdlUserName').value = '';
                const pwdEl = document.getElementById('cpMdlPassword');
                const newPwdEl = document.getElementById('cpMdlNewPassword');
                const confPwdEl = document.getElementById('cpMdlConfirmNewPassword');
                pwdEl.value = ''; pwdEl.type = 'password';
                newPwdEl.value = ''; newPwdEl.type = 'password';
                confPwdEl.value = ''; confPwdEl.type = 'password';
                document.querySelectorAll('#customerPortalModal .mdi-eye-off-outline').forEach(el => { el.className = 'mdi mdi-eye-outline'; });
                new bootstrap.Modal(document.getElementById('customerPortalModal')).show();
            };

            window.openCustomerResetPasswordModal = function (custId, custName, email, phone) {
                window.openPortalAccountModal(custId, custName, email, phone, true);
            };

            window.submitCustomerPortalModal = function () {
                const custId = Number(document.getElementById('cpMdlCustId').value);
                const hasAcc = document.getElementById('cpMdlHasAccount').value === 'true';
                if (!hasAcc) {
                    const userName = document.getElementById('cpMdlUserName').value.trim();
                    const password = document.getElementById('cpMdlPassword').value;
                    if (!userName || !password) {
                        SwalHelper.warning('نام کاربری و رمز عبور الزامی هستند.');
                        return;
                    }
                    if (password.length < 8) {
                        SwalHelper.warning('رمز عبور باید حداقل ۸ کاراکتر شامل حروف بزرگ، کوچک، عدد و نماد باشد.');
                        return;
                    }
                    fetch(apiBase + '/Customer/ActivatePortalAccount', {
                        method: 'POST',
                        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            customerId: custId,
                            userName: userName,
                            password: password,
                            phone: document.getElementById('cpMdlPhone').value.trim() || null,
                            email: document.getElementById('cpMdlEmail').value.trim() || null
                        })
                    }).then(r => r.json()).then(res => {
                        SwalHelper.handleResponse(res, 'حساب پرتال مشتری با موفقیت فعال شد.', function () { window.location.reload(); });
                    }).catch(() => SwalHelper.error('خطا در ارتباط با سرور هنگام فعال‌سازی حساب پرتال.'));
                } else {
                    const newPassword = document.getElementById('cpMdlNewPassword').value;
                    const confirmNewPassword = document.getElementById('cpMdlConfirmNewPassword').value;
                    if (!newPassword) {
                        SwalHelper.warning('رمز عبور جدید را وارد کنید.');
                        return;
                    }
                    if (newPassword.length < 8) {
                        SwalHelper.warning('رمز عبور جدید باید حداقل ۸ کاراکتر شامل حروف بزرگ، کوچک، عدد و نماد باشد.');
                        return;
                    }
                    if (newPassword !== confirmNewPassword) {
                        SwalHelper.warning('رمز عبور جدید و تکرار آن مطابقت ندارند.');
                        return;
                    }
                    fetch(apiBase + '/Customer/ResetPortalPassword', {
                        method: 'POST',
                        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
                        body: JSON.stringify({ customerId: custId, newPassword: newPassword })
                    }).then(r => r.json()).then(res => {
                        SwalHelper.handleResponse(res, 'رمز عبور پرتال مشتری بازنشانی شد.', function () {
                            bootstrap.Modal.getInstance(document.getElementById('customerPortalModal'))?.hide();
                        });
                    }).catch(() => SwalHelper.error('خطا در ارتباط با سرور هنگام بازنشانی رمز عبور.'));
                }
            };
        })();
    </script>
}