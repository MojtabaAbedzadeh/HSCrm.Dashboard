@using HSCrm.Dashboard.Costants
@model IEnumerable<ProductModel>

@{
    ViewData["Title"] = "محصولات";
    ViewData["selected"] = "product_list";

    string ApiAddress = ViewBag.ApiAddress;
    string valTenantId = ViewBag.TenantId;
    string valUserId = ViewBag.UserId;
}

@section styles {
    <link href="~/assets/plugins/data-tables/datatables.bootstrap5.min.css" rel="stylesheet">
    <link href="~/assets/plugins/data-tables/responsive.datatables.min.css" rel="stylesheet">
    <link href="~/assets/css/ekka.css" id="ekka-css" rel="stylesheet">
    <link href="~/lib/persiandate/persian-datepicker.css" rel="stylesheet" />
}

<style>
    .stautus-row {
        display: inline-block;
        width: 85px;
        font-weight: normal;
        padding: 4px;
        font-size: 12px;
        border-radius: 8px;
    }

    .confirmed-row {
        color: #009688;
        background-color: #d8f7f4;
    }

    .rejected-row {
        color: #F44336;
        background-color: #f1d3d1;
    }
</style>

<div class="breadcrumb-wrapper breadcrumb-contacts">
    <div>
        <h1>لیست مشتریان</h1>
        <p class="breadcrumbs"><span><a href="index.html">خانه</a></span> <span><i class="mdi mdi-chevron-left"></i></span>محصول</p>
    </div>
    @if (ViewBag.FiscalYearStatus == "0")
    {
        <div>
            @if (User.HasPermission(Permissions.Products.Create))
            {
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addProduct"> اضافه کردن محصول </button>
            }
        </div>
    }
</div>
@if (ViewBag.FiscalYearStatus != "0")
{
    <div class="alert alert-primary col-lg-8" role="alert" style="margin-top:40px; color:#084298;">
        توجه!
        <br>
        سال مالی انتخاب شده بسته می باشد! شما فقط قادر به مشاهده گزارشات سیستم هستید.
    </div>
}
<div class="row">
    <div class="col-12">
        <div class="ec-vendor-list card card-default">
            <div class="card-body">
                <div class="table-responsive-md">
                    <div id="responsive-data-table_wrapper" class="dataTables_wrapper dt-bootstrap5 no-footer">
                        <table id="responsive-data-table" class="table dataTable no-footer" aria-describedby="responsive-data-table_info">
                            <thead>
                                <tr>
                                    <th>عنوان محصول</th>
                                    <th>واحد</th>
                                    <th>وضعیت</th>
                                    <th>قیمت خرید</th>
                                    <th>قیمت فروش</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.ProductTitle</td>
                                        <td>@item.ProductUnit</td>
                                        <td>
                                            <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                                @(item.IsActive ? "فعال" : "غیرفعال")
                                            </span>
                                        </td>
                                        <td>@item.BuyPrice</td>
                                        <td>@item.SellPrice</td>
                                        <td>
                                            <div class="btn-group mb-1">
                                                <button type="button" class="btn btn-outline-success">اطلاعات</button>
                                                <button type="button" class="btn btn-outline-success dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-display="static">
                                                    <span class="sr-only">اطلاعات</span>
                                                </button>
                                                @if (ViewBag.FiscalYearStatus == "0")
                                                {
                                                    <div class="dropdown-menu">
                                                        @if (User.HasPermission(Permissions.ProductPrices.Create))
                                                        {
                                                            <a class="dropdown-item" href="#" onclick="showInsertPriceModel(@item.ProductId, '@item.ProductTitle')">قیمت جدید</a>
                                                        }
                                                        @if (User.HasPermission(Permissions.ProductPrices.View))
                                                        {
                                                            <a class="dropdown-item" href="#" onclick="productPriceHistory(@item.ProductId, '@item.ProductTitle')">تاریخچه قیمت</a>
                                                        }
                                                        <hr />
                                                        @if (User.HasPermission(Permissions.Products.Edit))
                                                        {
                                                            <a class="dropdown-item" href="#" onclick="showUpdateModal(@item.ProductId)">ویرایش</a>
                                                        }
                                                        @if (User.HasPermission(Permissions.Products.Delete))
                                                        {
                                                            <a class="dropdown-item" href="#" onclick="">حذف</a>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="dropdown-menu"></div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@if (ViewBag.FiscalYearStatus == "0")
{
    <div class="modal fade modal-add-contact" id="addProduct" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <form id="frmProduct">
                    <div class="modal-header px-4">
                        <h5 class="modal-title" id="exampleModalCenterTitle">تعریف محصول جدید</h5>
                    </div>
                    <div class="modal-body px-4">
                        <div class="row mb-2">
                            <div class="col-lg-4">
                                <div class="form-group form-floating">
                                    <input class="form-control text-end" id="ProductTitle" name="ProductTitle" placeholder="عنوان محصول">
                                    <label for="ProductTitle" style="right:0!important; left:unset!important;">عنوان محصول</label>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="form-group form-floating">
                                    <input class="form-control text-end" id="ProductUnit" name="ProductUnit" placeholder="واحد">
                                    <label for="ProductUnit" style="right:0!important; left:unset!important;">واحد</label>
                                </div>
                            </div>
                            <div class="col-lg-4" style="margin-bottom:8px;">
                                <div class="form-check" style="margin:auto;">
                                    <input style="font-size:13px;" type="checkbox" class="form-check-input chk-date-type" id="IsActive">
                                    <label for="IsActive" class="lbl-date-change">فعال</label>
                                </div>
                            </div>
                            <input id="TenantId" name="TenantId" value="@valTenantId" hidden>
                            <input id="UserId" name="UserId" value="@valUserId" hidden>
                            <div class="col-lg-12 alert" style="color:red">
                                <span class="text-danger" id="spnValidate"></span>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer px-4">
                        <button type="button" class="btn btn-secondary btn-pill" data-bs-dismiss="modal">
                            لغو
                        </button>
                        <button id="btnProductSubmit" type="button" class="btn btn-primary btn-pill">ذخیره </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal fade modal-add-contact" id="editProduct" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <form id="frmEditProduct">
                    <div class="modal-header px-4">
                        <h5 class="modal-title" id="exampleModalCenterTitle">ویرایش محصول</h5>
                    </div>
                    <div class="modal-body px-4">
                        <div class="row mb-2">
                            <input id="ProductId" name="ProductId" hidden>
                            <div class="col-lg-4">
                                <div class="form-group form-floating">
                                    <input class="form-control text-end" id="ProductTitleU" name="ProductTitleU" placeholder="عنوان محصول">
                                    <label for="ProductTitleU" style="right:0!important; left:unset!important;">عنوان محصول</label>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="form-group form-floating">
                                    <input class="form-control text-end" id="ProductUnitU" name="ProductUnitU" placeholder="واحد">
                                    <label for="ProductUnitU" style="right:0!important; left:unset!important;">واحد</label>
                                </div>
                            </div>
                            <div class="col-lg-4" style="margin-bottom:8px;">
                                <div class="form-check" style="margin:auto;">
                                    <input style="font-size:13px;" type="checkbox" class="form-check-input chk-date-type" id="IsActiveU" name="IsActiveU">
                                    <label for="IsActiveU" class="lbl-date-change">فعال</label>
                                </div>
                            </div>
                            <div class="col-lg-12 alert" style="color:red">
                                <span class="text-danger" id="spnValidateU"></span>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer px-4">
                        <button type="button" class="btn btn-secondary btn-pill" data-bs-dismiss="modal">
                            لغو
                        </button>
                        <button id="btnProductUpdate" type="button" class="btn btn-primary btn-pill">ذخیره </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal fade modal-add-contact" id="addNewPriceModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <form id="frmPrice">
                    <div class="modal-header px-4">
                        <h5 class="modal-title" id="ProductTitle"></h5>
                    </div>
                    <div class="modal-body px-4">
                        <div class="row mb-2">
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label for="BuyPrice">قیمت خرید</label>
                                    <input type="number" min="0" class="form-control" id="BuyPrice" name="BuyPrice">
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label for="SellPrice">قیمت فروش</label>
                                    <input type="number" min="0" class="form-control" id="SellPrice" name="SellPrice">
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group">
                                    <label for="ActionDate">تاریخ اعمال</label>
                                    <input autocomplete="off" class="form-control persian-date" id="EffectiveFrom" name="EffectiveFrom">
                                </div>
                            </div>
                            <input id="UserId" name="UserId" value="@ViewBag.UserId" hidden />
                            <input id="FiscalYearId" name="FiscalYearId" value="@ViewBag.FiscalYearId" hidden />
                            <input id="TenantId" name="TenantId" value="@ViewBag.TenantId" hidden />
                            <input id="ProId" name="ProId" hidden />
                            <div class="col-lg-12 alert" style="color:red">
                                <span class="text-danger" id="spnValidate"></span>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer px-4">
                        <button type="button" class="btn btn-secondary btn-pill" data-bs-dismiss="modal">لغو</button>
                        <button id="btnPriceSubmit" type="button" class="btn btn-primary btn-pill">ذخیره </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal fade modal-add-contact" id="productPriceHistoryModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header px-4">
                    <h5 class="modal-title" id="productPriceHistory"></h5>
                </div>
                <div class="modal-body px-4">
                    <div class="row mb-2">
                        <div class="table-responsive">
                            <table id="tblProductPriceHistory" class="table table-hover" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>ردیف</th>
                                        <th>قیمت خرید</th>
                                        <th>قیمت فروش</th>
                                        <th>تاریخ اعمال</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer px-4">
                    <button type="button" class="btn btn-secondary btn-pill" data-bs-dismiss="modal"> لغو</button>
                </div>
            </div>
        </div>
    </div>
}
@section AdminScripts {
    <!--Date picker js -->
    <script src="~/lib/persiandate/persian-date.js"></script>
    <script src="~/lib/persiandate/persian-datepicker.js"></script>
    <script>
        $(document).ready(function () {
            $('.persian-date').persianDatepicker({
                format: 'YYYY/MM/DD',
                autoClose: true,
                calendarSwitch: {
                    "enabled": false,
                    "format": "MMMM"
                },
            });
        });
    </script>
    <!--Show add price modal-->
    <script>
        function showInsertPriceModel(productId, productTitle) {
            $("#ProductId").val(productId);
            $("#productTitle").text('درج قیمت برای ' + productTitle);
            $("#addNewPriceModal").modal('show');
        }
    </script>
    <!--Add new product-->
    <script>
        $("#btnProductSubmit").on('click', function (e) {
            e.preventDefault();
            var productTitle = $("#ProductTitle").val();
            var productUnit = $("#ProductUnit").val();
            if (!productTitle || productTitle.trim() === "") {
                SwalHelper.warning("عنوان محصول را وارد نمایید!");
                return false;
            }
            if (!productUnit || productUnit.trim() === "") {
                SwalHelper.warning("واحد محصول را وارد نمایید!");
                return false;
            }
            var formData = new FormData($("#frmProduct")[0]);
            formData.set("IsActive", $("#IsActive").is(":checked"));
            $.ajax({
                type: 'POST',
                url: '@ApiAddress' + 'Product/CreateProduct',
                processData: false,
                contentType: false,
                dataType: "json",
                data: formData,
                headers: {
                    Authorization: 'Bearer ' + '@User.FindFirstValue("Token")'
                },
                success: function (xhr) {
                    SwalHelper.handleResponse(xhr, "ثبت محصول با موفقیت انجام شد!", function () {
                        $('#addProduct').modal('hide');
                        $('#ProductTitle').val("");
                        $('#chkActive').val("");
                        $('#ProductUnit').val("");
                        window.location.reload();
                    });
                },
                error: function (xhr) {
                    var msg = (xhr.responseJSON && xhr.responseJSON.message) || "خطا در ثبت محصول";
                    SwalHelper.error(msg);
                }
            });
        });
    </script>
    <!--Show product update modal-->
    <script>
        function showUpdateModal(productId) {
            $.ajax({
                type: 'GET',
                url: '@ApiAddress' + 'Product/GetById?productId=' + productId,
                dataType: 'json',
                headers: {
                    "Authorization": "Bearer " + "@User.FindFirstValue("Token")"
                },
                success: function (xhr) {
                    if (xhr && xhr.data) {
                        $("#ProductId").val(xhr.data.id);
                        $("#ProductTitleU").val(xhr.data.productTitle);
                        $("#ProductUnitU").val(xhr.data.productUnit);
                        $("#IsActiveU").prop("checked", xhr.data.isActive);
                        $("#editProduct").modal('show');
                    } else {
                        SwalHelper.error("اطلاعات محصول یافت نشد.");
                    }
                },
                error: function () {
                    SwalHelper.error("خطا در بازیابی اطلاعات محصول.");
                }
            });
        }
    </script>
    <!--Update Product-->
    <script>
        $("#btnProductUpdate").on('click', function (e) {
            e.preventDefault();
            var title = $("#ProductTitleU").val();
            if (!title || title.trim() === "") {
                SwalHelper.warning("عنوان محصول را وارد نمایید!");
                return false;
            }
            var model = {
                productId: $("#ProductId").val(),
                productTitle: $("#ProductTitleU").val(),
                productUnit: $("#ProductUnitU").val(),
                isActive: $("#IsActiveU").is(":checked"),
                modifiedById: '@valUserId'
            };
            $.ajax({
                type: 'PUT',
                url: '@ApiAddress' + 'Product/UpdateProduct',
                dataType: 'json',
                contentType: 'application/json',
                processData: false,
                data: JSON.stringify(model),
                headers: {
                    "Authorization": "Bearer " + "@User.FindFirstValue("Token")"
                },
                success: function (xhr) {
                    SwalHelper.handleResponse(xhr, "ویرایش محصول با موفقیت انجام شد!", function () {
                        $('#editProduct').modal('hide');
                        window.location.reload();
                    });
                },
                error: function (xhr) {
                    var msg = (xhr.responseJSON && xhr.responseJSON.message) || "خطا در ویرایش محصول";
                    SwalHelper.error(msg);
                }
            });
        });
    </script>
    <!--Add new price-->
    <script>
        $("#btnPriceSubmit").on('click', function (e) {
            e.preventDefault();
            var buyPrice = $("#BuyPrice").val();
            var sellPrice = $("#SellPrice").val();
            var actionDate = $("#ActionDate").val();
            if (!buyPrice || !sellPrice || !actionDate) {
                SwalHelper.warning("لطفاً قیمت خرید، قیمت فروش و تاریخ اعمال را به صورت کامل وارد نمایید!");
                return false;
            }
            var formData = new FormData($("#frmPrice")[0]);
            $.ajax({
                type: 'POST',
                url: '@ApiAddress' + 'ProductPrice/CreatePrice',
                processData: false,
                contentType: false,
                dataType: "json",
                data: formData,
                headers: {
                    Authorization: 'Bearer ' + '@User.FindFirstValue("Token")'
                },
                success: function (xhr) {
                    SwalHelper.handleResponse(xhr, "قیمت جدید محصول با موفقیت ثبت شد!", function () {
                        $('#addNewPriceModal').modal('hide');
                        window.location.reload();
                    });
                },
                error: function (xhr) {
                    var msg = (xhr.responseJSON && xhr.responseJSON.message) || "خطا در ثبت قیمت جدید";
                    SwalHelper.error(msg);
                }
            });
        });
    </script>
    <!--Show product price history-->
    <script>
        function productPriceHistory(productId, productTitle) {
            $("#productPriceHistory").text('لیست قیمت ' + productTitle);
            $.ajax({
                type: 'GET',
                url: '@ApiAddress' + 'ProductPrice/GetProductPriceHistory?productId=' + productId,
                dataType: 'json',
                headers: {
                    "Authorization": "Bearer " + "@User.FindFirstValue("Token")"
                },
                success: function (xhr) {
                    $("#tblProductPriceHistory tbody").empty();
                    var list = xhr.data || [];
                    if (list.length === 0) {
                        $("#tblProductPriceHistory tbody").append('<tr><td colspan="5" class="text-center text-muted py-3">تاریخچه قیمتی یافت نشد.</td></tr>');
                    } else {
                        $.each(list, function (i, v) {
                            var rowClass = v.isActive ? 'confirmed-row' : 'rejected-row';
                            var formattedDate = v.effectiveFrom ? new persianDate(new Date(v.effectiveFrom)).format("YYYY/MM/DD") : '-';
                            $("#tblProductPriceHistory tbody").append(
                                "<tr class='" + rowClass + "'>" +
                                "<td>" + (i + 1) + "</td>" +
                                "<td>" + Number(v.buyPrice).toLocaleString() + "</td>" +
                                "<td>" + Number(v.sellPrice).toLocaleString() + "</td>" +
                                "<td>" + formattedDate + "</td>" +
                                "<td><a class='text-danger' style='cursor:pointer; font-size:11px;' onclick='deletePrice(" + v.id + ")'>حذف</a></td>" +
                                "</tr>"
                            );
                        });
                    }
                    $("#productPriceHistoryModal").modal('show');
                },
                error: function () {
                    SwalHelper.error("خطا در بارگذاری تاریخچه قیمت محصول.");
                }
            });
        }
    </script>
}