@using System.Security.Claims
@{
    string apiAddress = ViewBag.ApiAddress?.ToString() ?? "";
    string token = ViewBag.Token?.ToString() ?? "";
    string firstName = ViewBag.FirstName?.ToString() ?? "";
    string lastName = ViewBag.LastName?.ToString() ?? "";
    string fullName = string.IsNullOrWhiteSpace($"{firstName} {lastName}".Trim()) ? (User.Identity?.Name ?? "مشتری گرامی") : $"{firstName} {lastName}".Trim();
    string fyTitle = ViewBag.FiscalYearTitle?.ToString() ?? "سال مالی فعال";
    string selected = ViewData["selected"]?.ToString() ?? "user_home";
    string avatarRaw = ViewBag.UserImageUrl?.ToString() ?? "";
    string avatarSrc = string.IsNullOrWhiteSpace(avatarRaw) ? Url.Content("~/assets/img/user/user.png") : avatarRaw;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <partial name="~/Areas/AdminArea/Views/Shared/_HeaderLinks.cshtml" />
    <title>@(ViewData["Title"] ?? "پرتال اختصاصی مشتریان")</title>
    <style>
        body { font-family: 'IRANSans', 'Vazir', Tahoma, sans-serif; background-color: #f6f8fb; }
        .cp-sidebar { width: 250px; min-height: 100vh; background: #fff; border-left: 1px solid #e9ecef; }
        .cp-nav-link { display: flex; align-items: center; gap: 10px; padding: 11px 16px; border-radius: 10px; color: #3f4a5a; text-decoration: none; font-weight: 500; margin-bottom: 4px; transition: all .15s; }
        .cp-nav-link:hover { background: #f1f5ff; color: #2b59c3; }
        .cp-nav-link.active { background: #2b59c3; color: #fff; box-shadow: 0 4px 12px rgba(43, 89, 195, .2); }
        @@media (max-width: 991.98px) {
            .cp-sidebar { width: 100%; min-height: auto; border-left: none; border-bottom: 1px solid #e9ecef; }
        }
        @@media print {
            .no-print, .cp-sidebar, header { display: none !important; }
            .cp-main { padding: 0 !important; margin: 0 !important; width: 100% !important; }
        }
    </style>
    @await RenderSectionAsync("styles", false)
</head>
<body>
    <header class="bg-white border-bottom sticky-top px-3 px-lg-4 py-2 d-flex justify-content-between align-items-center shadow-sm no-print">
        <div class="d-flex align-items-center gap-3">
            <a href="/UserArea/Home/Index" class="text-decoration-none d-flex align-items-center gap-2">
                <span class="badge bg-primary p-2 rounded-3"><i class="mdi mdi-account-star-outline fs-5"></i></span>
                <div>
                    <div class="fw-bold text-dark">پرتال اختصاصی مشتریان</div>
                    <small class="text-muted" style="font-size:11px;">پیگیری پروژه، فاکتورها و صورت‌حساب مالی</small>
                </div>
            </a>
        </div>

        <div class="d-flex align-items-center gap-3">
            <span class="badge bg-light text-dark border d-none d-md-inline-flex align-items-center gap-1 py-2 px-3">
                <i class="mdi mdi-calendar-check text-primary"></i> @fyTitle
            </span>

            <!-- زنگوله اعلان‌های مشتری -->
            <div class="dropdown">
                <button class="btn btn-light position-relative rounded-circle p-2" data-bs-toggle="dropdown" aria-expanded="false" title="اعلان‌ها">
                    <i class="mdi mdi-bell-outline fs-5 text-dark"></i>
                    <span id="cpNotifBadge" class="badge bg-danger rounded-pill position-absolute top-0 start-0 d-none" style="font-size:10px;">0</span>
                </button>
                <div class="dropdown-menu dropdown-menu-end shadow p-0" style="width: 330px; max-height: 400px; overflow-y: auto;">
                    <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                        <strong class="small"><i class="mdi mdi-bell-ring-outline me-1 text-primary"></i>اعلان‌های پروژه و مالی</strong>
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small" onclick="cpMarkAllNotificationsRead()">خواندن همه</button>
                    </div>
                    <div id="cpNotifList" class="list-group list-group-flush small">
                        <div class="p-3 text-center text-muted">در حال بارگذاری...</div>
                    </div>
                </div>
            </div>

            <!-- منوی کاربر -->
            <div class="dropdown">
                <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3 py-1" data-bs-toggle="dropdown" aria-expanded="false">
                    <img src="@avatarSrc" alt="avatar" class="rounded-circle" style="width:28px;height:28px;object-fit:cover;" onerror="this.src='/assets/img/user/user.png'" />
                    <span class="small fw-bold text-dark d-none d-sm-inline">@fullName</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow small">
                    <li><a class="dropdown-item" href="/UserArea/Profile/Index"><i class="mdi mdi-account-cog-outline me-1"></i>پروفایل و تغییر رمز عبور</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="mdi mdi-logout me-1"></i>خروج از حساب</a></li>
                </ul>
            </div>
        </div>
    </header>

    <div class="d-flex flex-column flex-lg-row">
        <aside class="cp-sidebar p-3 no-print">
            <div class="small text-muted fw-bold mb-2 px-2">منوی پرتال مشتری</div>
            <nav class="nav flex-column">
                <a class="cp-nav-link @(selected == "user_home" ? "active" : "")" href="/UserArea/Home/Index">
                    <i class="mdi mdi-view-dashboard-outline fs-5"></i><span>پیشخوان من</span>
                </a>
                <a class="cp-nav-link @(selected == "user_projects" ? "active" : "")" href="/UserArea/Project/Index">
                    <i class="mdi mdi-progress-check fs-5"></i><span>پروژه‌ها و پیشرفت کار</span>
                </a>
                <a class="cp-nav-link @(selected == "user_invoices" ? "active" : "")" href="/UserArea/Invoice/Index">
                    <i class="mdi mdi-file-document-outline fs-5"></i><span>فاکتورهای فروش و چاپ A4</span>
                </a>
                <a class="cp-nav-link @(selected == "user_statement" ? "active" : "")" href="/UserArea/Statement/Index">
                    <i class="mdi mdi-scale-balance fs-5"></i><span>دریافت‌ها و صورت‌حساب ۳۶۰</span>
                </a>
                <a class="cp-nav-link @(selected == "user_profile" ? "active" : "")" href="/UserArea/Profile/Index">
                    <i class="mdi mdi-account-edit-outline fs-5"></i><span>پروفایل و امنیت</span>
                </a>
                <hr class="my-2" />
                <a class="cp-nav-link text-danger" href="/Account/Logout">
                    <i class="mdi mdi-logout fs-5"></i><span>خروج از سیستم</span>
                </a>
            </nav>
        </aside>

        <main class="flex-grow-1 p-3 p-lg-4 cp-main">
            @RenderBody()
        </main>
    </div>

    <partial name="~/Areas/AdminArea/Views/Shared/_FooterLinks.cshtml" />
    <script>
        (function () {
            const rawApi = '@apiAddress';
            window.cpApiBase = rawApi.endsWith('/') ? rawApi : rawApi + '/';
            window.cpToken = '@token';

            function esc(v) {
                return String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }

            window.cpLoadNotifications = function () {
                if (!window.cpApiBase || !window.cpToken) return;
                fetch(window.cpApiBase + 'Notification/GetMyNotifications?limit=20', {
                    headers: { 'Authorization': 'Bearer ' + window.cpToken },
                    suppressGlobalAlert: true
                })
                .then(r => r.ok ? r.json() : null)
                .then(res => {
                    const feed = res?.data;
                    const badge = document.getElementById('cpNotifBadge');
                    const list = document.getElementById('cpNotifList');
                    if (!feed || !list) return;

                    if (feed.unreadCount > 0 && badge) {
                        badge.textContent = feed.unreadCount;
                        badge.classList.remove('d-none');
                    } else if (badge) {
                        badge.classList.add('d-none');
                    }

                    const items = feed.items || [];
                    if (items.length === 0) {
                        list.innerHTML = '<div class="p-3 text-center text-muted">اعلان جدیدی وجود ندارد.</div>';
                        return;
                    }

                    list.innerHTML = items.map(n => `
                        <a href="javascript:void(0)" onclick="cpClickNotification(${n.id ?? 'null'}, '${esc(n.actionUrl || '')}')"
                           class="list-group-item list-group-item-action py-2 ${n.isRead ? 'opacity-75' : 'bg-light'}">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <strong class="text-${n.severity === 'danger' ? 'danger' : n.severity === 'success' ? 'success' : 'primary'}">${esc(n.title)}</strong>
                                ${!n.isRead ? '<span class="badge bg-primary">جدید</span>' : ''}
                            </div>
                            <div class="text-muted mt-1">${esc(n.message)}</div>
                            <div class="text-muted mt-1" style="font-size:10px;" dir="ltr">${esc(n.createdAtShamsi)}</div>
                        </a>`).join('');
                }).catch(() => {});
            };

            window.cpClickNotification = function (id, url) {
                if (id) {
                    fetch(window.cpApiBase + 'Notification/MarkAsRead/' + id, {
                        method: 'POST',
                        headers: { 'Authorization': 'Bearer ' + window.cpToken },
                        suppressGlobalAlert: true
                    }).finally(() => {
                        if (url) window.location.href = url;
                        else window.cpLoadNotifications();
                    });
                } else if (url) {
                    window.location.href = url;
                }
            };

            window.cpMarkAllNotificationsRead = function () {
                fetch(window.cpApiBase + 'Notification/MarkAllAsRead', {
                    method: 'POST',
                    headers: { 'Authorization': 'Bearer ' + window.cpToken },
                    suppressGlobalAlert: true
                }).then(() => window.cpLoadNotifications());
            };

            document.addEventListener('DOMContentLoaded', window.cpLoadNotifications);
        })();
    </script>
    @await RenderSectionAsync("UserScripts", required: false)
</body>
</html>
