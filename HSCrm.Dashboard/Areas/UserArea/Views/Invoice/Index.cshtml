@{
    ViewData["Title"] = "فاکتورهای فروش و چاپ A4";
    ViewData["selected"] = "user_invoices";
}

<div class="mb-3 no-print">
    <h4 class="fw-bold mb-1">فاکتورهای فروش من</h4>
    <p class="text-muted small mb-0">مشاهده وضعیت تسویه فاکتورها و دریافت نسخه چاپی رسمی A4 با مشخصات و لوگوی شرکت</p>
</div>

<div class="card border-0 shadow-sm no-print">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle small">
                <thead class="table-light">
                    <tr>
                        <th>شماره فاکتور</th>
                        <th>پروژه</th>
                        <th>تاریخ صدور</th>
                        <th>وضعیت</th>
                        <th class="text-end">جمع کل (ریال)</th>
                        <th class="text-end">پرداخت‌شده (ریال)</th>
                        <th class="text-end">مانده (ریال)</th>
                        <th class="text-center">چاپ / جزئیات</th>
                    </tr>
                </thead>
                <tbody id="cpInvoicesBody">
                    <tr><td colspan="8" class="text-center py-4 text-muted">در حال دریافت فاکتورها...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- مودال چاپ رسمی A4 فاکتور فروش -->
<div class="modal fade" id="customerPrintInvoiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light no-print">
                <h5 class="modal-title"><i class="mdi mdi-printer me-1 text-primary"></i>پیش‌نمایش رسمی فاکتور (A4)</h5>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-warning fw-bold" onclick="printCurrentCustomerInvoice()">
                        <i class="mdi mdi-printer me-1"></i>چاپ فاکتور (A4)
                    </button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
            </div>
            <div class="modal-body p-4 bg-white" id="cpA4PrintSheet" dir="rtl">
                <div class="text-center py-5 text-muted">در حال آماده‌سازی پیش‌نمایش فاکتور...</div>
            </div>
        </div>
    </div>
</div>

@section UserScripts {
<script>
(function () {
    const apiRoot = window.cpApiBase.replace(/\/api\/?$/i, '/');
    let invoiceCache = [];
    function esc(v) { return String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

    fetch(window.cpApiBase + 'CustomerPortal/Invoices', {
        headers: { 'Authorization': 'Bearer ' + window.cpToken }
    })
    .then(r => r.json())
    .then(res => {
        invoiceCache = res?.data || [];
        const tbody = document.getElementById('cpInvoicesBody');
        if (invoiceCache.length === 0) {
            tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">فاکتوری برای حساب شما ثبت نشده است.</td></tr>';
            return;
        }
        tbody.innerHTML = invoiceCache.map(inv => `
            <tr>
                <td class="fw-bold font-monospace">${esc(inv.number)}</td>
                <td>${esc(inv.projectTitle)}</td>
                <td class="font-monospace">${esc(inv.issueDateShamsi)}</td>
                <td><span class="badge ${inv.status === 2 ? 'bg-success' : inv.status === 3 ? 'bg-danger' : 'bg-secondary'}">${esc(inv.statusTitle)}</span></td>
                <td class="text-end font-monospace">${Number(inv.total || 0).toLocaleString('fa-IR')}</td>
                <td class="text-end font-monospace text-success">${Number(inv.paidAmount || 0).toLocaleString('fa-IR')}</td>
                <td class="text-end font-monospace text-danger">${Number(inv.remainingAmount || 0).toLocaleString('fa-IR')}</td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="openCustomerInvoicePrint(${inv.id})">
                        <i class="mdi mdi-printer me-1"></i>مشاهده و چاپ A4
                    </button>
                </td>
            </tr>`).join('');
    });

    let currentCpPrintData = null;
    let currentCpPrintTpl = null;

    function resolveCpLogo(url) {
        if (!url) return '';
        if (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('data:')) return url;
        return apiRoot + url.replace(/^\/+/, '');
    }

    window.openCustomerInvoicePrint = function (id) {
        const inv = invoiceCache.find(x => x.id === id);
        if (!inv) return;

        const c = inv.companyInfo || {};
        currentCpPrintTpl = window.HSCrmPrint
            ? window.HSCrmPrint.mergeTemplate(c.invoicePrintTemplateJson || '')
            : null;

        currentCpPrintData = {
            invoiceKind: 'sales',
            number: inv.number || String(inv.id),
            dateShamsi: inv.issueDateShamsi || '-',
            statusText: inv.statusTitle || '-',
            partyName: inv.customerName || '-',
            secondaryRef: inv.projectTitle || '-',
            partyPhone: inv.customerPhone || '-',
            partyAddress: inv.customerAddress || '',
            items: (inv.items || []).map(it => ({
                title: it.productTitle || '-',
                unit: it.unit || '-',
                quantity: Number(it.quantity || 0),
                unitPrice: Number(it.unitPrice || 0),
                discount: Number(it.discount || 0),
                tax: Number(it.tax || 0),
                lineTotal: Number(it.total || 0)
            })),
            total: Number(inv.total || 0),
            paidAmount: Number(inv.paidAmount || 0),
            remainingAmount: Number(inv.remainingAmount || 0),
            notes: '',
            company: {
                companyTitle: c.companyTitle || 'صورت‌حساب فروش',
                logoSrc: resolveCpLogo(c.logoUrl),
                taxId: c.taxId || '',
                companyPhone: c.companyPhone || '',
                address: c.address || '',
                footerText: c.invoiceFooterText || '',
                currency: 'IRR'
            }
        };

        const sheetEl = document.getElementById('cpA4PrintSheet');
        if (window.HSCrmPrint && typeof window.HSCrmPrint.renderInvoiceHtml === 'function') {
            sheetEl.innerHTML = window.HSCrmPrint.renderInvoiceHtml(currentCpPrintData, currentCpPrintTpl);
        }

        new bootstrap.Modal(document.getElementById('customerPrintInvoiceModal')).show();
    };

    window.printCurrentCustomerInvoice = function () {
        if (!currentCpPrintData) return;
        if (window.HSCrmPrint && typeof window.HSCrmPrint.printInvoiceData === 'function') {
            window.HSCrmPrint.printInvoiceData(currentCpPrintData, currentCpPrintTpl);
        }
    };
})();
</script>
}