@{
    ViewData["Title"] = "پیشخوان مشتری";
    ViewData["selected"] = "user_home";
}

<div class="mb-4">
    <h4 class="fw-bold mb-1" id="cpWelcomeTitle">خوش آمدید</h4>
    <p class="text-muted small mb-0" id="cpWelcomeSub">خلاصه وضعیت پروژه‌ها، پیشرفت کارگاهی و مانده حساب شما</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">تعداد پروژه‌ها (فعال / کل)</div>
                <div class="fs-4 fw-bold text-primary mt-1" id="kpiProjects">-</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">میانگین پیشرفت فیزیکی</div>
                <div class="fs-4 fw-bold text-success mt-1" id="kpiProgress">-%</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">جمع فاکتورهای فروش (ریال)</div>
                <div class="fs-5 fw-bold text-dark font-monospace mt-1" id="kpiInvoices">-</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">مانده حساب دفتری (ریال)</div>
                <div class="fs-5 fw-bold font-monospace mt-1" id="kpiBalance">-</div>
                <div class="small text-muted mt-1" id="kpiPendingCheques"></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="mdi mdi-briefcase-outline me-1 text-primary"></i>پروژه‌های اخیر من</h6>
                <a href="/UserArea/Project/Index" class="btn btn-sm btn-outline-primary">مشاهده همه</a>
            </div>
            <div class="card-body" id="cpRecentProjects">
                <div class="text-center text-muted py-4">در حال بارگذاری...</div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="mdi mdi-timeline-clock-outline me-1 text-success"></i>آخرین گزارش‌های پیشرفت کارگاهی</h6>
                <a href="/UserArea/Project/Index" class="btn btn-sm btn-outline-success">جزئیات پروژه‌ها</a>
            </div>
            <div class="card-body" id="cpRecentLogs">
                <div class="text-center text-muted py-4">در حال بارگذاری...</div>
            </div>
        </div>
    </div>
</div>

@section UserScripts {
<script>
(function () {
    function esc(v) { return String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

    fetch(window.cpApiBase + 'CustomerPortal/Dashboard', {
        headers: { 'Authorization': 'Bearer ' + window.cpToken }
    })
    .then(r => r.json())
    .then(res => {
        const d = res?.data;
        if (!d) return;

        document.getElementById('cpWelcomeTitle').textContent = `خوش آمدید، ${d.customerName}`;
        if (d.companyTitle) {
            document.getElementById('cpWelcomeSub').textContent = `${d.companyTitle} — خلاصه وضعیت پروژه‌ها، پیشرفت کارگاهی و حساب مالی`;
        }

        document.getElementById('kpiProjects').textContent = `${d.activeProjectsCount} / ${d.totalProjectsCount}`;
        document.getElementById('kpiProgress').textContent = `${Number(d.averageProgressPercent || 0).toFixed(1)}%`;
        document.getElementById('kpiInvoices').textContent = Number(d.totalInvoicesAmount || 0).toLocaleString('fa-IR');

        const balEl = document.getElementById('kpiBalance');
        const bal = Number(d.netOpenBalance || 0);
        balEl.textContent = Math.abs(bal).toLocaleString('fa-IR') + (bal > 0 ? ' (بدهکار)' : bal < 0 ? ' (بستانکار)' : ' (تسویه)');
        balEl.className = 'fs-5 fw-bold font-monospace mt-1 ' + (bal > 0 ? 'text-danger' : 'text-success');

        if ((d.pendingChequesAmount || 0) > 0) {
            document.getElementById('kpiPendingCheques').textContent = `چک‌های در جریان: ${Number(d.pendingChequesAmount).toLocaleString('fa-IR')} ریال`;
        }

        const rpEl = document.getElementById('cpRecentProjects');
        const projects = d.recentProjects || [];
        if (projects.length === 0) {
            rpEl.innerHTML = '<div class="text-center text-muted py-4">هنوز پروژه‌ای ثبت نشده است.</div>';
        } else {
            rpEl.innerHTML = projects.map(p => `
                <div class="border rounded p-3 mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <a href="/UserArea/Project/Details/${p.id}" class="fw-bold text-dark text-decoration-none">${esc(p.projectTitle)}</a>
                        <span class="badge ${p.status === 'Completed' ? 'bg-success' : 'bg-primary'}">${esc(p.statusTitle)}</span>
                    </div>
                    <div class="progress mb-1" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width:${Math.min(100, Math.max(0, Number(p.progressPercent || 0)))}%"></div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>پیشرفت: ${Number(p.progressPercent || 0).toFixed(1)}%</span>
                        <span>فازها: ${p.completedMilestonesCount}/${p.milestonesCount}</span>
                    </div>
                </div>`).join('');
        }

        const rlEl = document.getElementById('cpRecentLogs');
        const logs = d.recentProgressLogs || [];
        if (logs.length === 0) {
            rlEl.innerHTML = '<div class="text-center text-muted py-4">هنوز گزارش پیشرفتی ثبت نشده است.</div>';
        } else {
            rlEl.innerHTML = logs.map(l => `
                <div class="border-bottom pb-2 mb-2">
                    <div class="d-flex justify-content-between">
                        <strong class="small text-primary">${esc(l.title)}</strong>
                        <span class="badge bg-light text-dark border">${esc(l.logDateShamsi)}</span>
                    </div>
                    <div class="small text-muted">${esc(l.projectTitle)} ${l.milestoneTitle ? '· ' + esc(l.milestoneTitle) : ''}</div>
                    <div class="small mt-1">${esc(l.reportText)}</div>
                </div>`).join('');
        }
    });
})();
</script>
}
